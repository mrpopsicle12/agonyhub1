    local function tradeRemote(name)
        local r = getRemote({"RemoteServices", "TradingService", "RE", name})
        if r and (r:IsA("RemoteEvent") or r:IsA("UnreliableRemoteEvent")) then
            return r
        end
        return nil
    end
    local function tradeData()
        if cachedDataController == nil then
            local good, data = pcall(function()
                return require(RS.Controllers.Core.DataController)
            end)
            if good and type(data) == "table" then cachedDataController = data end
        end
        if not cachedDataController then return nil end
        local ok, replica = pcall(function() return cachedDataController:GetReplica() end)
        if ok and type(replica) == "table" and type(replica.Data) == "table" then
            return replica.Data
        end
        return nil
    end
    local function ownedPets()
        local data = tradeData()
        local pets = data and data.Pets
        if type(pets) ~= "table" or type(pets.Owned) ~= "table" then
            return nil, nil
        end
        return pets, data
    end
    -- False/0/nil mean NOT frozen. Earlier versions used ~= nil and
    -- silently skipped perfectly tradeable variants with Frozen=false.
    local function activeFrozenFlag(value)
        if value == nil or value == false or value == 0 or value == "" then return false end
        if type(value) == "table" then return next(value) ~= nil end
        if type(value) == "string" then
            local v = value:lower()
            return v ~= "false" and v ~= "0" and v ~= "none"
        end
        return true
    end
    local function petFrozen(record)
        return type(record) == "table"
            and (activeFrozenFlag(record.Frozen) or activeFrozenFlag(record.FrozenAlso))
    end
    local function availablePet(id, record, pets, data)
        if type(id) ~= "string" or type(record) ~= "table" then return false end
        if type(record.Name) ~= "string" then return false end
        if petFrozen(record) or record.Locked == true then return false end
        if type(pets.Equipped) == "table" and table.find(pets.Equipped, id) then return false end
        if player:GetAttribute("EnchantHeldPet") == id or
           player:GetAttribute("EnchantAutoPet") == id then return false end
        local enchanting = data and data.Enchanting
        if type(enchanting) == "table" and type(enchanting.Pending) == "table"
            and enchanting.Pending.PetId == id then return false end
        return true
    end
