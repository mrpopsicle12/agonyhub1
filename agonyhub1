    end)

    -- Connect once per current RemoteEvent; reconnect if it gets replaced.
    -- Old listeners are disconnected so re-execution never duplicates hooks.
    task.spawn(function()
        while alive do
            local event = getRemote({
                "RemoteServices", "EggService", "RE", "SecretEggFlash"
            })
            if event and not (event:IsA("RemoteEvent")
                or event:IsA("UnreliableRemoteEvent")) then
                event = nil
            end
            if event ~= webhook.event
                or (event and not webhook.connection) then
                if webhook.connection then
                    pcall(function() webhook.connection:Disconnect() end)
                    webhook.connection = nil
                end
                webhook.event = event
                webhook.listening = false
                if event then
                    local ok, connection = pcall(function()
                        return event.OnClientEvent:Connect(function(...)
                            local eventOk, eventErr = pcall(handleSecret, ...)
                            if not eventOk then
                                warn("[AGONY WEBHOOK] SecretEggFlash callback failed:",
                                    tostring(eventErr):sub(1, 180))
                            end
                        end)
                    end)
                    if ok and connection then
                        webhook.connection = connection
                        table.insert(conns, connection)
                        webhook.listening = true
                        print("[AGONY WEBHOOK] SecretEggFlash connected (" .. event.ClassName .. ")")
                    else
                        warn("[AGONY WEBHOOK] SecretEggFlash listener unavailable")
                    end
                end
                if webhook.enabled then
                    setStatus(webhook.listening and "LISTENING" or "WAITING REMOTE",
                        webhook.listening and C.green or C.red)
                end
            end
            task.wait(2)
        end
    end)

    -- Webhook URL is saved locally and deliberately excluded from config codes.
    task.defer(function()
        if not hasFile or not ensureFolder() then return end
        local ok, saved = pcall(function()
            if isfile(path) then
                return Http:JSONDecode(readfile(path))
            end
        end)
        if ok and type(saved) == "table" and type(saved.URL) == "string"
            and validDiscordWebhook(saved.URL) then
            w.box.Text = saved.URL
            webhook.url = saved.URL
            -- Migration: older SAVE URL stored Enabled=false when the user
            -- saved *before* turning the toggle on, even if it later worked.
            -- From v2 onwards, explicit OFF is always respected.
            if saved.Enabled == true or saved.SavedMode ~= "v2" then
                setWebhook(true)
            else
                setStatus("OFF (SAVED)", C.muted)
            end
        end
    end)
end

