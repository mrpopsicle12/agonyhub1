local function listSavedConfigs()
    local names, seen = {}, {}
    local function add(name)
        if type(name) ~= "string" or not name:match("^[%w_%-]+$")
            or name:sub(1, 1) == "_" then return end
        -- Only genuine saved config documents count as files.  Never list
        -- _secret_webhook.json or other metadata/credentials in the picker.
        local path = folder .. "/" .. name .. ".json"
        if not hasFile or not isfile(path) then return end
        local ok, data = pcall(function() return Http:JSONDecode(readfile(path)) end)
        if not ok or type(data) ~= "table"
            or (type(data.Main) ~= "table" and data.AutoEgg == nil
                and data.AutoEvent == nil) then return end
        if not seen[name] then
            seen[name] = true
            table.insert(names, name)
        end
    end
    if hasFile and type(listfiles) == "function" then
        local ok, paths = pcall(listfiles, folder)
        if ok and type(paths) == "table" then
            for _, path in ipairs(paths) do
                local p = tostring(path):gsub("\\", "/")
                add(p:match("/([%w_%-]+)%.json$"))
            end
        end
    end
    if hasFile and isfile(configIndexPath) then
        local ok, manifest = pcall(function()
            return Http:JSONDecode(readfile(configIndexPath))
