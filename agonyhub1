local loadingFinished = false
local function finishLoading()
    if not alive or loadingFinished then return end
    loadingFinished = true
    pcall(function()
        barFill.Size = UDim2.fromScale(1, 1)
        barLabel.Text = "Loading... 100%"
    end)
