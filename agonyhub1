-- Shared HTTP helper for user-configured Discord webhook only.
-- No usage tracker, registration, heartbeat, or analytics requests.
local function findExecutorHttpRequest()
    local pools = {env, _G}
    for _, pool in ipairs(pools) do
        if type(pool) == "table" then
            for _, key in ipairs({"request", "http_request", "httprequest", "HTTP_REQUEST"}) do
                if type(pool[key]) == "function" then return pool[key] end
            end
            for _, key in ipairs({"syn", "http", "fluxus", "httpservice", "krnl"}) do
                local group = pool[key]
                if type(group) == "table" then
                    if type(group.request) == "function" then return group.request end
                    if type(group.Request) == "function" then return group.Request end
                end
            end
        end
    end
    return nil
end

