    local function controller()
        if tradeController then return tradeController end
        local scriptFolder = RS:FindFirstChild("Controllers")
        local module = scriptFolder and scriptFolder:FindFirstChild("Trading")
        module = module and module:FindFirstChild("TradingController")
        if not module or not module:IsA("ModuleScript") then return nil end
        local ok, value = pcall(require, module)
        if ok and type(value) == "table" then tradeController = value end
        return tradeController
    end
    local function debugTrade()
        local ctrl = controller()
        if not ctrl or type(ctrl.GetDebugState) ~= "function" then return nil end
        local ok, value = pcall(function() return ctrl:GetDebugState() end)
        if ok and type(value) == "table" then return value end
        return nil
    end
    local function samePets(a, b)
        if type(a) ~= "table" or type(b) ~= "table" then return false end
        local seen, count, otherCount = {}, 0, 0
        for _, id in pairs(a) do
            local key = tostring(id)
            seen[key] = (seen[key] or 0) + 1
            count += 1
        end
        for _, id in pairs(b) do
            local key = tostring(id)
            if not seen[key] or seen[key] <= 0 then return false end
            seen[key] -= 1
            otherCount += 1
        end
        return count == otherCount
    end
    local desiredIds = nil
    local targetBusyUntil = -math.huge
    local busyRetries = 0
    local function stopTrade(msg, isError)
        -- Stop ONLY this session, never the continuous pet watch.
        lastTradeClosedAt = os.clock()
        sessionFinished = true
        sessionArmed = false
        sessionSucceeded = isError ~= true and msg == "Trade completed automatically"
        if msg then
            tradeStatus(msg .. (autoEnabled and "; watching next pet" or ""),
                isError and C.red or C.green)
        end
    end
    -- Verify the full server-confirmed offer. Never accept extra pets,
    -- currencies, or items beyond the exact selected pet-ID set.
    local function ownServerOfferMatches(data)
        if type(data) ~= "table" or not samePets(data.PetIds or {}, desiredIds or {}) then
            return false
        end
        if tonumber(data.Tokens or 0) ~= 0 then return false end
        if data.Refs ~= nil then
            if type(data.Refs) ~= "table" then return false end
            local offered = {}
            for _, ref in pairs(data.Refs) do
                if type(ref) ~= "table" or ref.TypeName ~= "Pet"
                    or tonumber(ref.Amount) ~= 1 or type(ref.Uid) ~= "string" then
                    return false
                end
                table.insert(offered, ref.Uid)
            end
            if not samePets(offered, desiredIds or {}) then return false end
        end
        return true
    end
    local function currentOfferSafe(snapshot)
        if type(snapshot) ~= "table" or tonumber(snapshot.PartnerUserId) == nil then
            return false, "Waiting for trade state"
        end
        if tonumber(snapshot.PartnerUserId) ~= currentTarget then
            return false, "Trade partner changed"
        end
        if snapshot.OfferPending == true then
            return false, "Offer still updating"
        end
        if tonumber(snapshot.Tokens or 0) ~= 0 then
            return false, "Unexpected trade currency"
        end
        -- Rely on the verified server Offer event, not a stale local
        -- controller selection table (which can be empty for raw remote offers).
        if not receivedOffer then
            return false, "Waiting for server-confirmed offer"
        end
        local ctrl = controller()
        if ctrl and type(ctrl.GetOfferedPets) == "function" then
            local ok, selection = pcall(function() return ctrl:GetOfferedPets() end)
            if ok and type(selection) == "table" and next(selection) ~= nil then
                local offered = {}
                for id, selected in pairs(selection) do
                    if selected == true then table.insert(offered, id) end
                end
                if #offered > 0 and not samePets(offered, desiredIds or {}) then
                    return false, "Client trade offer differs from verified server offer"
                end
            end
        end
        local pets, data = ownedPets()
        if not pets then return false, "Inventory not available" end
        for _, id in ipairs(desiredIds or {}) do
            if not availablePet(id, pets.Owned[id], pets, data) then
                return false, "Selected pet no longer available"
            end
        end
        return true
    end
    -- Incoming gift-only Auto Accept.  Independent from outgoing Auto Trade.
    -- It NEVER offers the user's pets or currency; it refuses to confirm if
    -- the game client has any own items selected.
    local function resetIncoming(message)
        if incomingActive or incomingPending ~= nil then
            lastTradeClosedAt = os.clock()
        end
        incomingActive = false
        incomingPending = nil
        incomingTradePaused = false
        incomingPartner = nil
        incomingGiftSeen = false
        incomingLockSent = false
        incomingConfirmSent = false
        incomingReadyAfter = 0
        incomingBlocked = false
        incomingStartedAt = 0
        incomingLastOfferAt = 0
        autoAcceptGeneration += 1
        if message and alive then tradeStatus(message, C.muted) end
    end
    local function ownIncomingOfferIsEmpty(snapshot)
        if type(snapshot) ~= "table" then return false end
        if tonumber(snapshot.SelectedOfferCount) ~= 0
            or tonumber(snapshot.Tokens) ~= 0
            or snapshot.YourEmpty ~= true then return false end
        local ok, goods = pcall(function()
            return require(RS.Controllers.Trading.TradeGoodsView)
        end)
        if ok and type(goods) == "table" and type(goods.HasMine) == "function" then
            local got, hasGoods = pcall(goods.HasMine)
            if not got or hasGoods then return false end
        end
        return true
    end
    local function otherHasGift(snapshot)
        if type(snapshot) ~= "table" then return false end
        if (tonumber(snapshot.OtherOfferCount) or 0) > 0
            or (tonumber(snapshot.OtherTokens) or 0) > 0 then return true end
        local ok, goods = pcall(function()
            return require(RS.Controllers.Trading.TradeGoodsView)
        end)
        if ok and type(goods) == "table" and type(goods.Theirs) == "function" then
            local good, refs = pcall(goods.Theirs)
            if good and type(refs) == "table" and next(refs) ~= nil then
                return true
            end
        end
        return false
    end
    local function runIncomingGift(generation)
        while alive and autoAcceptEnabled and incomingActive
            and autoAcceptGeneration == generation do
            local snapshot = debugTrade()
            local now = os.clock()
            if not Players:GetPlayerByUserId(incomingPartner) then
                resetIncoming("Sender left; awaiting another incoming trade")
                return
            end
            if type(snapshot) == "table" and snapshot.PartnerUserId ~= nil
                and tonumber(snapshot.PartnerUserId) ~= incomingPartner then
                resetIncoming("Incoming partner changed; no auto-confirm")
                return
            end
            if now - incomingStartedAt > 145 then
                resetIncoming("Incoming trade timed out; awaiting next request")
                return
            end
            -- Wait until the game's trade UI and replica are fully ready.
            -- An unfinished UI can temporarily report YourEmpty=false.
            if snapshot and tonumber(snapshot.PartnerUserId) == incomingPartner
                and snapshot.TradingEnabled == true and snapshot.View ~= nil then
                if not ownIncomingOfferIsEmpty(snapshot) then
                    incomingBlocked = true
                    tradeStatus("AUTO ACCEPT BLOCKED: own offer is not empty", C.red)
                elseif incomingBlocked then
                    -- Never resume automatic confirmation after an own offer
                    -- was detected; requires a fresh trade session.
                    tradeStatus("Own offer changed: auto-accept blocked", C.red)
                elseif incomingGiftSeen and otherHasGift(snapshot) then
                    if not incomingLockSent and snapshot.View == "Build"
                        and now >= incomingReadyAfter then
                        local event = tradeRemote("TradeRequested")
                        local sent = event and pcall(function()
                            event:FireServer({Action = "Lock", Locked = true})
                        end)
                        if sent then
                            incomingLockSent = true
                            tradeStatus("Gift detected; Auto Ready sent", C.green)
                        end
                    end
                    if incomingLockSent and not incomingConfirmSent
                        and snapshot.View == "Review"
                        and snapshot.LocalLocked == true
                        and otherHasGift(snapshot)
                        and ownIncomingOfferIsEmpty(snapshot) then
                        local event = tradeRemote("TradeRequested")
                        local sent = event and pcall(function()
                            event:FireServer({Action = "Confirm"})
                        end)
                        if sent then
                            incomingConfirmSent = true
                            tradeStatus("Incoming gift confirmed automatically", C.green)
                        end
                    end
                end
            end
            task.wait(0.2)
        end
    end
    local function startIncomingRequest(from)
        if not autoAcceptEnabled or not alive or sessionArmed
            or incomingPending ~= nil or incomingActive then return end
        if not Players:GetPlayerByUserId(from) then return end
        local snap = debugTrade()
        if type(snap) == "table" and snap.PartnerUserId ~= nil then return end
        -- Immediately stop NEW hatch requests, but keep the chosen Egg
        -- or Event mode ON so it automatically resumes when this trade ends.
        incomingPending = from
        incomingTradePaused = true
        if settingsUI.nativeAutoStop then
            pcall(settingsUI.nativeAutoStop, true)
        end
        tradeStatus("Incoming trade: hatch paused until trade finishes", C.green)
        autoAcceptGeneration += 1
        local generation = autoAcceptGeneration
        task.spawn(function()
            local accepted = false
            local deadline = os.clock() + 1.5
            while alive and autoAcceptEnabled and incomingPending == from
                and generation == autoAcceptGeneration and os.clock() < deadline do
                local current = debugTrade()
                if current and tonumber(current.RequestUserId) == from then
                    local ctrl = controller()
                    if ctrl and type(ctrl.RequestTrade) == "function" then
                        local ok, result = pcall(function() return ctrl:RequestTrade(from) end)
                        if ok and result == "Accepted" then
                            accepted = true
                            break
                        end
                    end
                end
                task.wait(0.12)
            end
            if not accepted and alive and autoAcceptEnabled
                and incomingPending == from and generation == autoAcceptGeneration then
                local event = tradeRemote("TradeRequested")
                accepted = event ~= nil and pcall(function()
                    event:FireServer({Action = "Respond", Accepted = true})
                end)
            end
            if accepted then
                tradeStatus("Incoming request accepted; waiting for their offer", C.green)
                task.delay(25, function()
                    if alive and incomingPending == from
                        and autoAcceptGeneration == generation then
                        resetIncoming("Incoming request expired; listening again")
                    end
                end)
            elseif incomingPending == from then
                resetIncoming("Could not accept incoming request")
            end
        end)
    end
    local function handleIncomingTradeUpdate(data)
        if not autoAcceptEnabled or type(data) ~= "table" then return end
        local kind = data.Type
        if kind == "Request" then
            local from = tonumber(data.FromUserId)
            if from and from ~= player.UserId then startIncomingRequest(from) end
        elseif kind == "Started" then
            if not sessionArmed and not incomingActive then
                local a, b = tonumber(data.A), tonumber(data.B)
                local partner = a == player.UserId and b or (b == player.UserId and a or nil)
                if partner and (incomingPending == nil or partner == incomingPending) then
                    -- Some clients receive Started without a Request event.
                    -- Preserve Auto Accept's empty-own-offer checks.
                    incomingPartner = partner
                    incomingPending = nil
                    incomingActive = true
                    incomingTradePaused = true
                    incomingStartedAt = os.clock()
                    incomingGiftSeen, incomingBlocked = false, false
                    incomingLockSent, incomingConfirmSent = false, false
                    incomingReadyAfter = os.clock() + 1.5
                    autoAcceptGeneration += 1
                    local generation = autoAcceptGeneration
                    task.spawn(runIncomingGift, generation)
                    tradeStatus("Incoming trade open; waiting for their gift", C.green)
                end
            end
        elseif kind == "Offer" or kind == "OfferRejected" then
            if incomingActive then
                if incomingConfirmSent then
                    incomingBlocked = true -- no second confirmation after changed offer
                end
                incomingLockSent = false
                incomingConfirmSent = false
                incomingLastOfferAt = os.clock()
                incomingReadyAfter = incomingLastOfferAt + math.max(1.5, tonumber(data.Cooldown) or 0)
                if tonumber(data.UserId) == incomingPartner then
                    local refs = data.Refs
                    local ids = data.PetIds or data.Pets
                    incomingGiftSeen = (type(refs) == "table" and next(refs) ~= nil)
                        or (type(ids) == "table" and next(ids) ~= nil)
                        or (tonumber(data.Tokens) or 0) > 0
                    tradeStatus(incomingGiftSeen and "Gift offer detected; awaiting Ready"
                        or "Other player's offer is empty", C.muted)
                elseif tonumber(data.UserId) == player.UserId then
                    if (type(data.Refs) == "table" and next(data.Refs) ~= nil)
                        or (type(data.PetIds) == "table" and next(data.PetIds) ~= nil)
                        or (tonumber(data.Tokens) or 0) ~= 0 then
                        incomingBlocked = true
                    end
                end
            end
        elseif kind == "Completed" or kind == "Cancelled" or kind == "Pending"
            or kind == "FailedValidation" or kind == "RequestExpired"
            or kind == "Denied" then
            if incomingActive or incomingPending ~= nil then
                resetIncoming("Incoming trade " .. tostring(kind):lower() .. "; still listening")
            end
        end
    end
    local function receiveTradeUpdate(data)
        if type(data) ~= "table" then return end
        local kind = data.Type
        -- When the chosen collector initiates a subsequent trade, use the
        -- outbound Secret-offer flow (not the empty-offer gift-only flow).
        -- A prior decline must not disable this response while pets remain.
        if autoEnabled and selectedUserId and not sessionArmed and not incomingActive
            and type(freshOfferIds) == "function" then
            if kind == "Request" and tonumber(data.FromUserId) == selectedUserId then
                -- If the gift-only accept path saw an earlier request, switch
                -- back to Secret-outgoing mode for the selected collector.
                if incomingPending == selectedUserId then
                    resetIncoming()
                end
                local good, ids = pcall(freshOfferIds, true)
                if good and type(ids) == "table" and #ids > 0 then
                    if os.clock() - lastCollectorResponseAt >= 2 then
                        local remote = tradeRemote("TradeRequested")
                        local accepted = remote and pcall(function()
                            remote:FireServer({Action = "Respond", Accepted = true})
                        end)
                        if accepted then
                            lastCollectorResponseAt = os.clock()
                            collectorResponsePendingUntil = os.clock() + 3
                            tradeStatus("Collector requested trade: accepting to send Secrets", C.green)
                            return -- Prevent Auto Accept's gift-only handler.
                        end
                    else
                        return -- Debounce a repeated Request notification.
                    end
                end
            elseif kind == "Started" then
                local a, b = tonumber(data.A), tonumber(data.B)
                local partner = a == player.UserId and b
                    or (b == player.UserId and a or nil)
                if partner == selectedUserId then
                    local good, ids = pcall(freshOfferIds, true)
                    if good and type(ids) == "table" and #ids > 0 then
                        -- Release an older gift-only pending state so it cannot
                        -- block the outgoing trade watcher on this new session.
                        if incomingPending == selectedUserId then
                            resetIncoming()
                        end
                        -- The continuous watcher attaches to the game session.
                        -- Do not start incoming gift-only automation here.
                        tradeStatus("Collector trade opened; preparing Secret offer", C.green)
                        return
                    end
                end
            end
        end
        if autoAcceptEnabled then
            local ok, err = pcall(handleIncomingTradeUpdate, data)
            if not ok then warn("[AGONY AUTO ACCEPT]", err) end
        end
        if not autoEnabled or not sessionArmed or sessionFinished then return end
        if kind == "Started" then
            local a, b = tonumber(data.A), tonumber(data.B)
            if (a == player.UserId and b == currentTarget)
                or (b == player.UserId and a == currentTarget) then
                sessionActive = true
                lastRevision, lockSent, localLocked = 0, false, false
                reviewStarted, confirmSent = false, false
                tradeStatus("Trade opened; offering selected pets", C.green)
            else
                stopTrade("Unexpected trade partner; Auto Trade stopped", true)
            end
        elseif kind == "OfferRejected" then
            if sessionActive and tonumber(data.UserId) == player.UserId then
                stopTrade("Pet offer rejected by game server", true)
            end
        elseif kind == "Offer" then
            if not sessionActive then return end
            if confirmSent then
                stopTrade("Trade offer changed after confirm", true)
                return
            end
            -- A new offer resets both ready states in the game's controller.
            if lockSent then
                lockSent, localLocked, reviewStarted = false, false, false
                tradeStatus("Offer changed; checking before re-lock", C.muted)
            end
            local waitTime = tonumber(data.Cooldown)
            local cfgOk, cfg = pcall(function() return require(RS.Shared.Trading.TradeTokens) end)
            if cfgOk and type(cfg) == "table" then
                waitTime = math.max(waitTime or tonumber(cfg.ReadyWait) or 1.5,
                    tonumber(cfg.OwnReadyWait) or 1.5)
            end
            readyAfter = math.max(readyAfter, os.clock() + (waitTime or 1.5))
            if tonumber(data.UserId) == player.UserId then
                if not ownServerOfferMatches(data) then
                    stopTrade("Server offer differs from selected pets; stopped", true)
                    return
                end
                lastRevision = tonumber(data.Revision) or lastRevision
                receivedOffer = true
                tradeStatus("Exact pet offer verified; awaiting Ready", C.green)
            end
        elseif kind == "Lock" then
            if sessionActive and tonumber(data.UserId) == player.UserId then
                localLocked = data.Locked == true
                if localLocked then
                    tradeStatus("Ready confirmed; awaiting review", C.green)
                elseif lockSent and not reviewStarted then
                    stopTrade("Server removed Ready; Auto Trade stopped", true)
                end
            end
        elseif kind == "Review" then
            if sessionActive and lockSent and receivedOffer then
                reviewStarted = true
                tradeStatus("Review started; checking offer before auto confirm", C.green)
            end
        elseif kind == "Confirm" then
            if sessionActive and tonumber(data.UserId) == player.UserId then
                confirmSent = true
                tradeStatus("Auto Confirm accepted; awaiting other player", C.green)
            end
        elseif kind == "Countdown" or kind == "Processing" or kind == "Securing" then
            if sessionActive then
                tradeStatus("Trade " .. tostring(kind):lower() .. "; awaiting completion", C.green)
            end
        elseif kind == "FailedValidation" then
            local reason = tostring(data.Reason or "Unknown")
            if reason == "ProfileCapacityLow" or reason == "ProfileTooLarge" then
                -- Keep retrying Secrets when the collector makes space,
                -- but allow their inventory a moment to update.
                targetBusyUntil = math.max(targetBusyUntil, os.clock() + 12)
                stopTrade("Recipient inventory needs space (will retry): " .. reason, true)
            else
                stopTrade("Trade validation failed (will retry): " .. reason, true)
            end
        elseif kind == "Cancelled" or kind == "RequestExpired"
            or kind == "Denied" then
            stopTrade("Trade ended: " .. tostring(kind) .. "; will retry owned Secrets", true)
        elseif kind == "Completed" then
            stopTrade("Trade completed automatically", false)
        elseif kind == "Pending" then
            stopTrade("Trade pending; check Trade History before retrying", true)
        end
    end
    local function ensureTradeUpdates()
        local event = tradeRemote("TradeUpdate")
        if not event then return false end
        if tradeUpdateEvent == event and tradeUpdateConnection then return true end
        if tradeUpdateConnection then
            pcall(function() tradeUpdateConnection:Disconnect() end)
        end
        tradeUpdateEvent = event
        local ok, connection = pcall(function()
            return event.OnClientEvent:Connect(receiveTradeUpdate)
        end)
        if not ok then return false end
        tradeUpdateConnection = connection
        table.insert(conns, connection)
        return true
    end
    local autoAcceptToggle = toggle(acceptRow, function(enabled)
        autoAcceptEnabled = enabled
        if enabled then
            if not ensureTradeUpdates() then
                autoAcceptEnabled = false
                error("TradingService.TradeUpdate not available")
            end
            tradeStatus("Auto Accept ON: incoming gifts only, own offer stays empty", C.green)
        else
            resetIncoming("Auto Accept OFF")
        end
    end)

    -- Real game protocol from InventoryController: PetActionRequested:Fire({
    --     Action = "ToggleLock", PetId = <unique owned ID>
    -- })
    -- Only SECRET-rarity pets are eligible. ToggleLock is non-idempotent, so
    -- send it only while replica explicitly reports Locked = true, rate-limit
    -- further attempts, and NEVER try to unlock a Frozen/FrozenAlso pet.
    local unlockAttempts = {} -- [unique ID] = last attempt time
    local unequipAttempts = {} -- [unique ID] = last attempt time
    local function petActionRemote()
        local event = getRemote({"RemoteServices", "PetService", "RE", "PetActionRequested"})
        if event and (event:IsA("RemoteEvent") or event:IsA("UnreliableRemoteEvent")) then
            return event
        end
        return nil
    end
    -- All Secret-rarity pets are selected automatically, regardless of mutation,
    -- tier, pet name, source egg, or whether the pet was owned when toggled ON.
    local secretCatalog = nil
    local secretCatalogByName = nil
    local function isSecretRarity(value)
        if type(value) ~= "string" then return false end
        local normalized = value:lower():match("^%s*(.-)%s*$") or ""
        -- Secret I/II/III/X or Secret 1/2/3, regardless of mutation.
        if normalized:sub(1, 6) ~= "secret" then return false end
        local boundary = normalized:sub(7, 7)
        return boundary == "" or boundary == " " or boundary == "-"
            or boundary == "_" or boundary == ":" or boundary == "("
    end
    local variantPrefixes = {"Shiny ", "Golden ", "Rainbow ", "Prismatic ", "Normal ", "Gold "}
    local function basePetName(value)
        if type(value) ~= "string" then return nil end
        local name = value:match("^%s*(.-)%s*$")
        if not name or name == "" then return nil end
        for _ = 1, 3 do
            local original = name
            for _, prefix in ipairs(variantPrefixes) do
                if name:sub(1, #prefix):lower() == prefix:lower() then
                    name = name:sub(#prefix + 1)
                    break
                end
            end
            if original == name then break end
        end
        return name
    end
    local function loadSecretCatalog()
        if secretCatalogByName then return secretCatalogByName end
        if not secretCatalog then
            local ok, catalog = pcall(function()
                return require(RS.Shared.Pets.OriginalPetCatalog)
            end)
            if not ok or type(catalog) ~= "table" then return nil end
            secretCatalog = catalog
        end
        local index = {}
        for key, entry in pairs(secretCatalog) do
            if type(entry) == "table" then
                if type(key) == "string" then index[key:lower()] = entry end
                for _, field in ipairs({"Name", "PetName", "BaseName"}) do
                    local name = entry[field]
                    if type(name) == "string" then index[name:lower()] = entry end
                end
            end
        end
        secretCatalogByName = index
        return index
    end
    local function isSecretRecord(record)
        if type(record) ~= "table" or type(record.Name) ~= "string" then return false end
        if isSecretRarity(record.Rarity) or isSecretRarity(record.BaseRarity)
            or isSecretRarity(record.PetRarity) then
            return true
        end
        -- A Golden/Shiny/etc. variant may advertise a variant-specific
        -- rarity. The ORIGINAL pet species decides whether it's a Secret.
        local index = loadSecretCatalog()
        if not index then return false end
        for _, field in ipairs({"Name", "BaseName", "OriginalName", "PetName"}) do
            local raw = record[field]
            local base = basePetName(raw)
            if base then
                local entry = index[base:lower()] or index[raw:lower()]
                if entry and (isSecretRarity(entry.Rarity)
                    or isSecretRarity(entry.BaseRarity)
                    or isSecretRarity(entry.PetRarity)) then
                    return true
                end
            end
        end
        return false
    end
    local function selectedRecord(id, record)
        return type(id) == "string" and isSecretRecord(record)
    end
    local function tryAutoUnlock(id, record)
        if not selectedRecord(id, record) or record.Locked ~= true then return false end
        -- Frozen pets require normal game unfreeze process, not ToggleLock.
        if petFrozen(record) then return false end
        -- Avoid lock-unlock flip-flops if replication of the first request lags.
        local now = os.clock()
        if now - (unlockAttempts[id] or -math.huge) < 30 then return false end
        local event = petActionRemote()
        if not event then
            tradeStatus("Waiting for PetService PetActionRequested remote", C.red)
            return false
        end
        unlockAttempts[id] = now
        local sent, err = pcall(function()
            event:FireServer({Action = "ToggleLock", PetId = id})
        end)
        tradeStatus(sent and ("Auto Unlock requested: " .. record.Name .. " (verifying)")
            or ("Auto Unlock failed: " .. tostring(err)), sent and C.muted or C.red)
        return sent
    end
    local function tryAutoUnequip(id, record, pets)
        if not selectedRecord(id, record) or type(pets.Equipped) ~= "table"
            or not table.find(pets.Equipped, id) then return false end
        if record.Locked == true or petFrozen(record) then
            return false
        end
        local now = os.clock()
        if now - (unequipAttempts[id] or -math.huge) < 8 then return false end
        local event = petActionRemote()
        if not event then return false end
        unequipAttempts[id] = now
        local sent = pcall(function()
            event:FireServer({Action = "Unequip", PetId = id})
        end)
        if sent then
            tradeStatus("Unequipping selected pet: " .. record.Name .. " (verifying)", C.muted)
        end
        return sent
    end
    freshOfferIds = function(ignoreRetryCooldown)
        local pets, data = ownedPets()
        if not pets then return nil, "Inventory not loaded" end
        local candidates = {}
        local now = os.clock()
        local pendingEquipped, pendingLocked, pendingFrozen = false, false, false
        for id, record in pairs(pets.Owned) do
            if selectedRecord(id, record) then
                if availablePet(id, record, pets, data) then
                    if ignoreRetryCooldown or attemptedIds[id] == nil or attemptedIds[id] <= now then
                        table.insert(candidates, id)
                    end
                elseif petFrozen(record) then
                    -- Frozen is a separate non-tradeable state. No guessed API.
                    pendingFrozen = true
                elseif record.Locked == true then
                    pendingLocked = true
                    tryAutoUnlock(id, record)
                elseif type(pets.Equipped) == "table" and table.find(pets.Equipped, id) then
                    pendingEquipped = true
                    tryAutoUnequip(id, record, pets)
                end
            end
        end
        if #candidates == 0 then
            if pendingFrozen then
                return {}, "Matching pet frozen/reserved - cannot trade until released"
            elseif pendingLocked then
                return {}, "Auto Unlock requested; waiting for unlocked replica state"
            elseif pendingEquipped then
                return {}, "Auto Unequip requested; waiting for inventory update"
            end
            return {}, "Waiting for Secret pets (any mutation)"
        end
        table.sort(candidates)
        local limit = maxTradePets()
        while #candidates > limit do table.remove(candidates) end
        return candidates, "Ready: " .. #candidates .. " Secret pet(s)"
    end
    local function sendRequestTo(uid)
        local ctrl = controller()
        if ctrl and type(ctrl.RequestTrade) == "function" then
            local ok, outcome = pcall(function() return ctrl:RequestTrade(uid) end)
            if ok and outcome == "Sent" then return true, "REQUEST SENT" end
            if ok and outcome == "Accepted" then return true, "REQUEST ACCEPTED" end
            if ok and outcome == "Waiting" then return false, "Trade request blocked by game" end
        end
        local event = tradeRemote("TradeRequested")
        if not event then return false, "TradingService remote missing" end
        local ok = pcall(function()
            event:FireServer({Action = "Request", TargetUserId = uid})
        end)
        return ok, ok and "REQUEST SENT" or "REQUEST FAILED"
    end
    local function sendSelectedOffer(ids, revision)
        local refs = {}
        for _, id in ipairs(ids) do
            table.insert(refs, {TypeName = "Pet", Uid = id, Amount = 1})
        end
        local event = tradeRemote("TradeRequested")
        if not event then return false end
        return pcall(function()
            event:FireServer({Action = "Offer", Refs = refs, Revision = revision or 0})
        end)
    end
    local function runAutoTrade(generation, joinExisting)
        local function active()
            return alive and autoEnabled and tradeGeneration == generation
        end
        if not ensureTradeUpdates() then
            stopTrade("TradeUpdate remote not available", true)
            return
        end
        local ok, reason
        if joinExisting then
            local snapshot = debugTrade()
            if type(snapshot) ~= "table" or tonumber(snapshot.PartnerUserId) ~= currentTarget
                or snapshot.TradingEnabled ~= true or snapshot.View ~= "Build" then
                stopTrade("Existing collector trade is not ready; retrying", true)
                return
            end
            ok, reason = true, "JOINED COLLECTOR TRADE"
            sessionActive = true
            -- Do not send another Request when the collector already opened it.
        else
            ok, reason = sendRequestTo(currentTarget)
        end
        requestSentAt = os.clock()
        if not ok then
            -- Another clone may be trading with the same receiver.
            -- Back off instead of stopping Auto Trade or spamming requests.
            if reason == "Trade request blocked by game" then
                busyRetries = math.min(busyRetries + 1, 5)
                targetBusyUntil = os.clock() + math.min(15, 3 + busyRetries * 2)
                for _, id in ipairs(desiredIds or {}) do
                    attemptedIds[id] = targetBusyUntil
                end
                stopTrade("Recipient busy; retrying after a short wait", true)
            else
                stopTrade(reason, true)
            end
            return
        end
        busyRetries = 0
        targetBusyUntil = -math.huge
        tradeStatus(reason .. "; awaiting player", C.muted)
        while active() and not sessionFinished do
            if not Players:GetPlayerByUserId(currentTarget) then
                stopTrade("Target left server", true)
                return
            end
            local snapshot = debugTrade()
            if type(snapshot) == "table" then
                local partner = tonumber(snapshot.PartnerUserId)
                if partner == currentTarget and snapshot.TradingEnabled == true then
                    sessionActive = true
                elseif partner and partner ~= currentTarget then
                    stopTrade("Another player is in the trade; stopped", true)
                    return
                end
            end
            if sessionActive and not sentOffer then
                local pets, data = ownedPets()
                local ids = desiredIds or {}
                local valid = pets ~= nil and #ids > 0
                if valid then
                    for _, id in ipairs(ids) do
                        if not availablePet(id, pets.Owned[id], pets, data) then
                            valid = false
                            break
                        end
                    end
                end
                if not valid then
                    stopTrade("Selected pets no longer available", true)
                    return
                end
                -- The game uses Revision=1 for the first Offer.
                if sendSelectedOffer(ids, 1) then
                    sentOffer = true
                    tradeStatus("Pet offer sent; awaiting server verification", C.muted)
                else
                    stopTrade("Could not send pet offer", true)
                    return
                end
            end
            if sentOffer and receivedOffer and not lockSent
                and os.clock() >= readyAfter then
                local safe, err = currentOfferSafe(snapshot)
                if not safe then
                    -- Allow the client's view to catch up while its offer is pending.
                    if err ~= "Offer still updating" and err ~= "Cannot verify offered pet IDs"
                        and err ~= "Inventory not available" and err ~= "Waiting for trade state" then
                        stopTrade(err, true)
                        return
                    end
                else
                    local event = tradeRemote("TradeRequested")
                    if not event then
                        stopTrade("Trade request remote disappeared", true)
                        return
                    end
                    local fired = pcall(function()
                        event:FireServer({Action = "Lock", Locked = true})
                    end)
                    if not fired then
                        stopTrade("Could not send Ready", true)
                        return
                    end
                    lockSent, lockSentAt = true, os.clock()
                    tradeStatus("Ready sent; waiting for server review", C.green)
                end
            end
            if reviewStarted and lockSent and receivedOffer and not confirmSent then
                -- Only confirm in the server-issued Review phase. The pet IDs,
                -- target, and tokens must still match immediately before sending.
                if type(snapshot) == "table" and snapshot.View == "Review"
                    and not snapshot.Processing then
                    local safe, err = currentOfferSafe(snapshot)
                    if not safe then
                        if err ~= "Offer still updating" then
                            stopTrade("Auto Confirm blocked: " .. tostring(err), true)
                            return
                        end
                    else
                        local event = tradeRemote("TradeRequested")
                        if not event then
                            stopTrade("Trade remote missing at review", true)
                            return
                        end
                        local fired = pcall(function()
                            event:FireServer({Action = "Confirm"})
                        end)
                        if not fired then
                            stopTrade("Could not send final Confirm", true)
                            return
                        end
                        confirmSent = true -- no second confirm and no auto-retry
                        confirmSentAt = os.clock()
                        tradeStatus("Final Confirm sent automatically", C.green)
                    end
                end
            end
            local elapsed = os.clock() - requestSentAt
            if not sessionActive and elapsed > 18 then
                stopTrade("Recipient has not accepted yet; retrying soon", true)
                return
            end
            if sentOffer and not receivedOffer and elapsed > 75 then
                stopTrade("No valid offer confirmation from server", true)
                return
            end
            if receivedOffer and not lockSent and elapsed > 90 then
                stopTrade("Ready could not be verified; stopped safely", true)
                return
            end
            if lockSent and not reviewStarted and os.clock() - lockSentAt > 50 then
                stopTrade("Server review not started; check other player's Ready", true)
                return
            end
            if confirmSent and confirmSentAt > 0
                and os.clock() - confirmSentAt > 80 then
                stopTrade("Trade status unknown; check Trade History before retrying", true)
                return
            end
            task.wait(0.15)
        end
    end
    local function resetTradeSession()
        sessionActive, sentOffer, receivedOffer = false, false, false
        lastRevision, readyAfter = 0, 0
        lockSent, lockSentAt, localLocked = false, 0, false
        reviewStarted, confirmSent, confirmSentAt = false, false, 0
        requestSentAt = 0
        sessionFinished, sessionSucceeded, sessionArmed = false, false, true
    end
    local function continuousTradeWatch(generation)
        local function active()
            return alive and autoEnabled and tradeGeneration == generation
        end
        local lastMessage = ""
        while active() do
            local nextMessage = nil
            if incomingActive or incomingPending ~= nil then
                nextMessage = "Auto Accept is handling incoming trade"
            elseif os.clock() < targetBusyUntil then
                nextMessage = "Recipient busy; waiting to retry (Auto Trade stays ON)"
            elseif os.clock() - lastTradeClosedAt < 2 then
                nextMessage = "Waiting for previous trade session to close"
            elseif not selectedUserId then
                nextMessage = "Choose a trade target; Auto Trade remains ON"
            elseif not Players:GetPlayerByUserId(selectedUserId) then
                nextMessage = "Waiting for selected player to join this server"
            elseif not tradeRemote("TradeRequested") or not ensureTradeUpdates() then
                nextMessage = "Waiting for TradingService remotes"
            else
                local snapshot = debugTrade()
                local partner = snapshot and tonumber(snapshot.PartnerUserId)
                local joinExisting = partner == selectedUserId
                    and snapshot.TradingEnabled == true and snapshot.View == "Build"
                -- The collector can initiate the second trade. In that case
                -- use Secrets that are still owned even during retry cooldown.
                local ids, reason = freshOfferIds(joinExisting)
                if not ids then
                    nextMessage = reason
                elseif #ids == 0 then
                    nextMessage = reason or "Waiting for matching pet in inventory"
                elseif not joinExisting and os.clock() < collectorResponsePendingUntil then
                    nextMessage = "Accepted collector request; waiting for trade to open"
                elseif partner ~= nil and not joinExisting then
                    nextMessage = "Current trade not ready; waiting for it to close"
                else
                        currentTarget = selectedUserId
                        desiredIds = ids
                        resetTradeSession()
                        -- Stop sending NEW egg-hatch requests immediately while
                        -- the current Secret trade is pending; preserve egg mode.
                        tradePaused = true
                        if settingsUI.nativeAutoStop then
                            pcall(settingsUI.nativeAutoStop, true)
                        end
                        local now = os.clock()
                        for _, id in ipairs(ids) do attemptedIds[id] = now + 5 end
                        tradeStatus("Detected " .. #ids .. " Secret(s); trading, hatch paused", C.green)
                        local jobOk, jobErr = pcall(runAutoTrade, generation, joinExisting)
                        tradePaused = false
                        if not jobOk then
                            warn("[AGONY TRADE] Session error:", jobErr)
                            stopTrade("Trade error; retrying shortly", true)
                        end
                        sessionArmed = false
                        if not active() then return end
                        if sessionSucceeded then
                            -- Completed means the server finished a session,
                            -- not that every offered pet has already vanished
                            -- from this client's inventory. Wait for replica
                            -- sync, then keep offering any Secret still owned.
                            local nowFinished = os.clock()
                            for _, id in ipairs(ids) do
                                attemptedIds[id] = nowFinished + 5
                            end
                            tradeStatus("Trade completed; rechecking remaining Secrets", C.green)
                        else
                            tradeStatus("Trade ended; Secrets still owned will be retried", C.muted)
                        end
                        desiredIds = nil
                        -- Resume hatch on return to this watcher (same Egg/Event mode).
                        -- Allow trade UI to finish closing; don't impose a long delay.
                        local pauseUntil = os.clock() + 1.5
                        while active() and os.clock() < pauseUntil do
                            task.wait(0.25)
                        end
                    end
                end
            if nextMessage and nextMessage ~= lastMessage then
                tradeStatus(nextMessage, C.muted)
                lastMessage = nextMessage
            end
            -- Fast inventory polling catches a new Secret after its pet record
            -- replicates even when the SecretEggFlash event comes earlier.
            task.wait(0.35)
        end
    end
    autoToggle = toggle(autoTradeRow, function(enabled)
        if not enabled then
            autoEnabled = false
            tradePaused = false
            tradeGeneration += 1
            sessionArmed = false
            sessionFinished = true
            return
        end
        -- ON is the persistent watching state, even with no owned pets.
        autoEnabled = true
        tradeGeneration += 1
        local generation = tradeGeneration
        tradeStatus("Auto Trade ON: monitoring ALL Secret-rarity pets", C.green)
        task.spawn(continuousTradeWatch, generation)
    end)
    -- Full config: preserve the TARGET account even if offline/left this server.
    settingsUI.getTradeConfig = function()
        return {
            TargetUserId = selectedUserId,
            TargetUsername = chooseUser.Text,
            AutoTrade = autoEnabled,
            AutoAcceptTrade = autoAcceptEnabled
        }
    end
    settingsUI.applyTradeConfig = function(data)
        if type(data) ~= "table" then return end
        -- Stop any former watcher first; change target only outside active session.
        if sessionArmed or incomingActive then
            tradeStatus("Current trade active; apply config after it ends", C.red)
            return
        end
        autoToggle(false)
        autoAcceptToggle(false)
        local id = tonumber(data.TargetUserId)
        selectedUserId = id and id > 0 and id or nil
        if selectedUserId then
            local person = Players:GetPlayerByUserId(selectedUserId)
            local name = person and person.Name or tostring(data.TargetUsername or "")
            if name == "" or name == "SELECT USER" then
                name = "ID " .. tostring(selectedUserId)
            end
            chooseUser.Text = name
        else
            chooseUser.Text = "SELECT USER"
        end
        if data.AutoAcceptTrade == true then pcall(autoAcceptToggle, true) end
        if data.AutoTrade == true then pcall(autoToggle, true) end
    end
    settingsUI.tradeShutdown = function()
        autoAcceptEnabled = false
        resetIncoming()
        autoEnabled = false
        tradePaused = false
        sessionArmed = false
        sessionFinished = true
        tradeGeneration += 1
        if tradeUpdateConnection then
            pcall(function() tradeUpdateConnection:Disconnect() end)
            tradeUpdateConnection = nil
        end
    end
    -- The pet catalog is built only when its dropdown is opened.
    on(tabs.Trade.MouseButton1Click, function()
        -- All Secrets mode: no per-pet selector is shown.
        tradeStatus(autoEnabled and "Auto Trade ON: monitoring ALL Secrets"
            or "Auto Trade OFF: ALL Secrets selected automatically", C.muted)
    end)
end
setupTrade()

-- ================================================================
-- AUTO SKILL TREE: server-authoritative unlocks for every config node.
-- Only invokes SkillTreeService.RF.Unlock({Name = nodeName}); checks the
-- replica and observed RPC results. No fabricated prices or bypasses.
-- ================================================================
local function setupSkillTree()
    local skillRow = card(pages.Main, "Auto Skill Tree")
    -- Keep internal skill status for diagnostics but no extra text row in Main.
    local skillMessage = {Text = "", TextColor3 = C.muted}
    local enabled, generation = false, 0
    local cachedDC = nil
    local nodeNames, nodeSet = {}, {}
    local nodeConfig = nil
    local lastCatalogAttempt = -math.huge
    local retryAfter = {}
    local inflight = false
    local setSkill
    local function say(message, color)
        if alive then
            skillMessage.Text = tostring(message)
            skillMessage.TextColor3 = color or C.muted
        end
    end
    local function skillData()
        if not cachedDC then
            local ok, result = pcall(function()
                return require(RS.Controllers.Core.DataController)
            end)
            if ok and type(result) == "table" then cachedDC = result end
        end
        if not cachedDC then return nil end
        local ok, replica = pcall(function() return cachedDC:GetReplica() end)
        if ok and type(replica) == "table" then return replica.Data end
        return nil
    end
    local function catalog()
        if nodeConfig then return nodeNames end
        if os.clock() - lastCatalogAttempt < 1 then return nodeNames end
        lastCatalogAttempt = os.clock()
        local module = getRemote({"Shared", "Progression", "SkillTreeConfig"}, "ModuleScript")
        if not module then return nodeNames end
        local ok, result = pcall(require, module)
        if not ok or type(result) ~= "table" then return nodeNames end
        nodeConfig = result
        local visited = {}
        local function walk(value, depth)
            if type(value) ~= "table" or visited[value] or depth > 12 then return end
            visited[value] = true
            if type(value.Name) == "string" and value.Name ~= ""
                and not nodeSet[value.Name] then
                nodeSet[value.Name] = true
                table.insert(nodeNames, value.Name)
            end
            for _, child in pairs(value) do walk(child, depth + 1) end
        end
        walk(result, 1)
        table.sort(nodeNames)
        return nodeNames
    end
    local function isUnlocked(data, name)
        local skillTree = data and data.SkillTree
        local unlocked = type(skillTree) == "table" and skillTree.Unlocked
        if type(unlocked) ~= "table" then return false end
        local state = unlocked[name]
        -- Some revisions store the unlocked rank as a number, not a boolean.
        return (state ~= nil and state ~= false and state ~= 0)
            or table.find(unlocked, name) ~= nil
    end
    local function unlockNode(name, token)
        if inflight then return nil, "WAITING FOR PREVIOUS RESPONSE" end
        local remote = getRemote({"RemoteServices", "SkillTreeService", "RF", "Unlock"}, "RemoteFunction")
        if not remote then return nil, "SkillTreeService.RF.Unlock not loaded" end
        inflight = true
        local done, ok, result = false, false, nil
        task.spawn(function()
            ok, result = pcall(function()
                return remote:InvokeServer({Name = name})
            end)
            done = true
            inflight = false
        end)
        local limit = os.clock() + 8
        while alive and enabled and generation == token and not done
            and os.clock() < limit do
            task.wait(0.05)
        end
        if not done then return nil, "WAITING FOR SERVER" end
        if not ok then return nil, "RPC ERROR: " .. tostring(result):sub(1, 70) end
        if type(result) ~= "table" then return false, "NO CONFIRMATION" end
        if result.Success == true then return true end
        return false, tostring(result.Reason or "Not affordable / prerequisite locked")
    end
    setSkill = toggle(skillRow, function(value)
        enabled = value
        generation += 1
        if not value then
            say("OFF - Auto Skill Tree paused")
            return
        end
        local token = generation
        say("Scanning skill tree...", C.green)
        task.spawn(function()
            while alive and enabled and generation == token do
                local nodes = catalog()
                local data = skillData()
                local unlocked = data and data.SkillTree and data.SkillTree.Unlocked
                if #nodes == 0 then
                    say("Waiting for Shared.Progression.SkillTreeConfig", C.red)
                    task.wait(0.75)
                elseif type(unlocked) ~= "table" then
                    say("Waiting for SkillTree replica data", C.muted)
                    task.wait(0.5)
                else
                    local now = os.clock()
                    local missing, improved, blocked, lastReason = 0, 0, 0, ""
                    for _, name in ipairs(nodes) do
                        if not alive or not enabled or generation ~= token then break end
                        data = skillData() or data
                        if not isUnlocked(data, name) then
                            missing += 1
                            if now >= (retryAfter[name] or -math.huge) then
                                local success, reason = unlockNode(name, token)
                                if success == true then
                                    improved += 1
                                    retryAfter[name] = os.clock() + 2
                                    say("Unlocked " .. name .. " | continuing all branches", C.green)
                                else
                                    blocked += 1
                                    lastReason = tostring(reason or "Unknown")
                                    retryAfter[name] = os.clock() +
                                        (lastReason == "WAITING FOR SERVER" and 5 or 1.5)
                                end
                                -- No artificial multi-second wait between
                                -- successful upgrades; still yield to network/UI.
                                task.wait(success == true and 0.06 or 0.10)
                            end
                        end
                    end
                    if alive and enabled and generation == token then
                        if missing == 0 then
                            say("ALL " .. #nodes .. " skill nodes unlocked!", C.green)
                        elseif improved == 0 then
                            local gems = data and data.Currencies and data.Currencies.Gems
                            say(string.format("%d/%d skills remain | Gems: %s | %s",
                                missing, #nodes, tostring(gems or "?"),
                                lastReason ~= "" and lastReason or "Waiting for Gems/prerequisites"))
                        end
                    end
                    task.wait(improved > 0 and 0.08 or 1.25)
                end
            end
        end)
    end)
    settingsUI.skillTreeIsOn = function() return enabled end
    settingsUI.setSkillTree = setSkill
    settingsUI.skillShutdown = function()
        enabled = false
        generation += 1
    end
end
setupSkillTree()

-- ================================================================
-- AUTO SHRINE: automatically travel to the REAL Autumn Shrine,
-- claim the best configured blessing, then resume egg farming.
-- Uses ShrineConfig.FindShrine / ShrineVisuals.GetPromptAttachment
-- and ShrineService.RF.Choose(key), as confirmed by the game source.
-- The existing shrine only checked proximity; this implementation
-- also handles distant/streamed-out shrines without ON/OFF retoggling.
-- Keep the player's current blessing if it already matches to avoid
-- resetting a hard-earned Tier II/III. Boss and Trade take priority.
-- ================================================================
local function setupAutoShrine()
    local shrineRow = card(pages.Main, "Auto Shrine")
    local enabled = false
    local generation = 0
    local travelling = false
    local nextTry = 0
    local cachedConfig = nil
    local cachedVisuals = nil
    -- The game's real Autumn Island landing position, already used by
    -- AGONY's manual Island Teleport. This is only a streaming fallback;
    -- the FINAL interaction uses the actual Shrine model/attachment.
    local AUTUMN_LANDING = Vector3.new(-73.2431793, 871.563477, -1716.6554)

    local function shrineConfig()
        if cachedConfig then return cachedConfig end
        local mod = getRemote({"Shared", "Game", "ShrineConfig"}, "ModuleScript")
        if not mod then return nil end
        local ok, cfg = pcall(require, mod)
        if ok and type(cfg) == "table" and type(cfg.Blessings) == "table"
            and type(cfg.Attributes) == "table" then
            cachedConfig = cfg
            return cfg
        end
        return nil
    end

    local function bestBlessingKey(cfg)
        -- The supplied ShrineConfig confirms the real keys:
        -- Golden = Golden & Rainbow Chance; Luck; AutoClicker.
        -- Prioritize mutation farming as requested, not GUI order.
        for _, key in ipairs({"Golden", "Luck", "AutoClicker"}) do
            local item = cfg.Blessings[key]
            if type(item) == "table" and item.Key == key then
                return key
            end
        end
        for _, effect in ipairs({"Golden & Rainbow Chance", "Luck", "Auto Click Speed"}) do
            for key, item in pairs(cfg.Blessings) do
                if type(key) == "string" and type(item) == "table"
                    and item.Effect == effect then
                    return key
                end
            end
        end
        return nil
    end

    local function targetPosition(cfg)
        -- Prefer exactly the attachment the native ShrineController uses.
        if not cachedVisuals then
            local mod = getRemote({"Modules", "Client", "Game", "ShrineVisuals"}, "ModuleScript")
            if mod then
                local ok, module = pcall(require, mod)
                if ok and type(module) == "table" then cachedVisuals = module end
            end
        end
        if cachedVisuals and type(cachedVisuals.GetPromptAttachment) == "function" then
            local ok, attachment = pcall(cachedVisuals.GetPromptAttachment)
            if ok and typeof(attachment) == "Instance"
                and attachment:IsA("Attachment") and attachment:IsDescendantOf(workspace) then
                local posOK, pos = pcall(function() return attachment.WorldPosition end)
                if posOK and typeof(pos) == "Vector3" then return pos end
            end
        end
        -- Fallback to the real model, not a speculative shrine coordinate.
        if type(cfg.FindShrine) == "function" then
            local ok, shrine = pcall(cfg.FindShrine)
            if ok and typeof(shrine) == "Instance" and shrine:IsA("Model") then
                -- If the visual helper is unavailable, prefer named
                -- interaction attachments inside the same genuine model.
                for _, part in ipairs(shrine:GetDescendants()) do
                    if part:IsA("Attachment") then
                        local name = part.Name:lower()
                        if name:find("prompt", 1, true) or name:find("interact", 1, true) then
                            return part.WorldPosition
                        end
                    end
                end
                local pivotOK, pivot = pcall(function() return shrine:GetPivot() end)
                if pivotOK and typeof(pivot) == "CFrame" then
                    return pivot.Position
                end
            end
        end
        return nil
    end

    local function interrupted(token)
        return not alive or not enabled or generation ~= token
            or bossFighting or (flags.boss and bossPresent)
            or hatchTradePaused()
            or workspace:GetAttribute("TS2ShrineSequence") == true
    end

    local function requestStream(pos)
        -- Do not let a slow RequestStreamAroundAsync hold busyMovement.
        task.spawn(function()
            pcall(function() player:RequestStreamAroundAsync(pos, 3) end)
        end)
    end

    local function teleportNear(pos)
        local root, hum = currentRoot(), currentHum()
        if not root or not hum or hum.Health <= 0 then return false end
        local place = pos + Vector3.new(0, 3, 0)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = player.Character and {player.Character} or {}
        params.IgnoreWater = true
        local hit = workspace:Raycast(pos + Vector3.new(0, 18, 0),
            Vector3.new(0, -55, 0), params)
        if hit and hit.Normal.Y > 0.55 then
            local offset = math.max(3, hum.HipHeight + root.Size.Y / 2 + 0.6)
            local groundPlace = hit.Position + Vector3.new(0, offset, 0)
            if (groundPlace - pos).Magnitude <= 15 then
                place = groundPlace
            end
        end
        return pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = CFrame.new(place)
        end)
    end

    local function chooseBlessing(remote, key, token)
        -- RemoteFunction can be slow or hang: keep the movement gate bounded.
        -- No overlapping RPCs, and never spam requests every Heartbeat.
        local completed, success, response = false, false, nil
        task.spawn(function()
            success, response = pcall(function()
                return remote:InvokeServer(key)
            end)
            completed = true
        end)
        local limit = os.clock() + 9
        while not completed and os.clock() < limit and not interrupted(token) do
            task.wait(0.08)
        end
        if not completed then
            return false, "WAITING FOR SHRINE RESPONSE"
        end
        if success and type(response) == "table" and response.Success == true then
            return true, "CLAIMED"
        end
        local reason = type(response) == "table" and response.Reason or response
        return false, tostring(reason or "SHRINE DID NOT CONFIRM")
    end

    local function shrineTrip(cfg, key, token)
        if interrupted(token) or busyMovement then return false, "BUSY" end
        local root, hum = currentRoot(), currentHum()
        if not root or not hum or hum.Health <= 0 then return false, "NO CHARACTER" end
        local before = root.CFrame
        local moved = false
        local useDistance = tonumber(cfg.UseDistance) or 45
        busyMovement = true -- pauses Auto-F and stops concurrent chest/island movement
        local ok, claimed, reason = pcall(function()
            -- Immediately stop the native auto-F session, WITHOUT disabling
            -- the AGONY Auto Hatch toggle; its worker resumes after we return.
            if eggMode and settingsUI.nativeAutoStop then
                pcall(settingsUI.nativeAutoStop)
            end
            if interrupted(token) then return false, "INTERRUPTED" end
            local destination = targetPosition(cfg)
            if destination == nil then
                -- From far islands the actual Shrine model might not have
                -- streamed in yet. Teleport to the known Autumn landing first.
                requestStream(AUTUMN_LANDING)
                if not teleportNear(AUTUMN_LANDING) then
                    return false, "AUTUMN TELEPORT FAILED"
                end
                moved = true
                local deadline = os.clock() + 7
                while not interrupted(token) and os.clock() < deadline do
                    destination = targetPosition(cfg)
                    if destination then break end
                    task.wait(0.20)
                end
            end
            if interrupted(token) then return false, "INTERRUPTED" end
            if destination == nil then return false, "SHRINE NOT STREAMED" end
            requestStream(destination)
            local rootNow = currentRoot()
            if not rootNow then return false, "CHARACTER LOST" end
            if (rootNow.Position - destination).Magnitude > useDistance - 7 then
                if not teleportNear(destination) then
                    return false, "SHRINE TELEPORT FAILED"
                end
                moved = true
            end
            -- Allow the replicated server character position to catch up.
            local settle = os.clock() + 0.35
            while os.clock() < settle and not interrupted(token) do task.wait(0.05) end
            if interrupted(token) then return false, "INTERRUPTED" end
            rootNow = currentRoot()
            if not rootNow or (rootNow.Position - destination).Magnitude > useDistance - 2 then
                return false, "NOT IN SHRINE RANGE"
            end
            local remote = getRemote({"RemoteServices", "ShrineService", "RF", "Choose"}, "RemoteFunction")
            if not remote then return false, "SHRINE REMOTE NOT READY" end
            return chooseBlessing(remote, key, token)
        end)

        -- Always release busyMovement, even on RPC failure / ON-OFF cycles.
        -- If Boss or Trade took over, don't teleport away from that activity.
        local higherPriority = bossFighting or (flags.boss and bossPresent)
            or hatchTradePaused()
        if moved and not higherPriority and alive then
            local returned = false
            if eggMode and type(settingsUI.shrineReturnToEgg) == "function" then
                local homeOK, homeResult = pcall(settingsUI.shrineReturnToEgg)
                returned = homeOK and homeResult == true
            end
            if not returned then
                local homeRoot, homeHum = currentRoot(), currentHum()
                if homeRoot and homeHum and homeHum.Health > 0 then
                    pcall(function()
                        homeRoot.AssemblyLinearVelocity = Vector3.zero
                        homeRoot.AssemblyAngularVelocity = Vector3.zero
                        homeRoot.CFrame = before
                    end)
                end
            end
        end
        busyMovement = false
        if not ok then return false, tostring(claimed) end
        return claimed == true, tostring(reason or "NO CONFIRMATION")
    end

    local setAutoShrine
    setAutoShrine = toggle(shrineRow, function(value)
        enabled = value
        generation += 1
        nextTry = 0
        if not value then return end
        local token = generation
        task.spawn(function()
            while alive and enabled and generation == token do
                local cfg = shrineConfig()
                local key = cfg and bestBlessingKey(cfg)
                local attr = cfg and cfg.Attributes.Blessing
                local activeKey = type(attr) == "string" and player:GetAttribute(attr) or nil
                -- Once the best blessing is active, STOP. Tier upgrades are
                -- based on elapsed time and switch resets them to Tier I.
                if cfg and key and activeKey ~= key and not travelling
                    and not busyMovement and not interrupted(token)
                    and os.clock() >= nextTry then
                    travelling = true
                    local success, message = shrineTrip(cfg, key, token)
                    travelling = false
                    if generation == token then
                        -- Retry automatically if streaming/remote is delayed.
                        -- Backoff protects against a perpetual teleport loop.
                        nextTry = os.clock() + (success and 30 or 12)
                    end
                    if env.AGONY_DEBUG then
                        consolePrint("[AGONY SHRINE]", success, message)
                    end
                end
                task.wait(0.35)
            end
        end)
    end)
    settingsUI.shrineIsOn = function() return enabled end
    settingsUI.setShrine = setAutoShrine
    settingsUI.shrineShutdown = function()
        enabled = false
        generation += 1
    end
end
