        if bossTimer.synced then return end
        local state = stateValue(data)
        if state == true then
            updateBossPresence(true)
        elseif state == false then
            updateBossPresence(false)
        end
        return
    end

    -- Server-authored State:Observe payload.
    if type(data.Phase) == "string" then
        local phase = data.Phase
        if phase ~= "Warning" and phase ~= "Fight"
            and phase ~= "Defeated" and phase ~= "Escaped" then
            phase = "Idle"
        end

        local fightId = data.FightId
        bossTimer.synced = true
        bossTimer.phase = phase
        bossTimer.startsAt = tonumber(data.StartsAt)
        bossTimer.endsAt = tonumber(data.EndsAt)
        bossTimer.fightId = fightId

        if phase == "Fight" then
            -- Ignore stale Fight updates for the same already-defeated boss.
            if bossTimer.deadLock
                and (fightId == bossTimer.deadFightId
                    or fightId == nil) then
                updateBossPresence(false)
            else
                bossTimer.deadLock = false
                defeated = false
                defeatedModel = nil
                bossState = true
                bossStateAt = os.clock()
                local hp = tonumber(data.Health)
                if hp and hp <= 0 then
                    recordDeath()
                else
                    updateBossPresence(true)
                end
            end
        elseif phase == "Defeated" or phase == "Escaped" then
            recordDeath()
            updateBossPresence(false)
        else
            -- Warning/Idle: don't fight or hover until Phase == Fight.
            if phase == "Warning" then
                bossTimer.deadLock = false
            end
            updateBossPresence(false)
        end
        bossTimer.render()
        return
    end

    -- Backward-compatible fallback only before a real phase subscription.
    if bossTimer.synced then return end
    local state = stateValue(data)
    if state == true then
        updateBossPresence(true)
    elseif state == false then
        updateBossPresence(false)
    end
end
