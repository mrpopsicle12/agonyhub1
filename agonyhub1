            for _, name in ipairs(manifest) do add(name) end
        end
    end
    if hasFile and isfile(folder .. "/" .. cleanName(configBox.Text) .. ".json") then
        add(cleanName(configBox.Text))
    end
    table.sort(names)
    return names
end
