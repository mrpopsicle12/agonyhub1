do
local keyOrder = {"best", "tap", "chest", "quest", "rebirth", "boss"}
local digits = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
local function base36(n)
n = math.floor(n)
if n == 0 then return "0" end
local out = ""
repeat
local d = n % 36
out = digits:sub(d + 1, d + 1) .. out
n = math.floor(n / 36)
until n == 0
return out
end
function settingsUI.encodeCompact()
local i = 1
for j, item in ipairs(raw) do
if item[1] == eggSelected then i = j break end
end
local bits = 0
for index, key in ipairs(keyOrder) do
if flags[key] then bits += 2 ^ (index - 1) end
end
if infiniteJump then bits += 2 ^ 6 end
if optimizeEnabled then bits += 2 ^ 7 end
if eggMode == "Egg" then bits += 2 ^ 8 end
if eggMode == "Event" then bits += 2 ^ 9 end
if settingsUI.reveal.isHold() then bits += 2 ^ 12 end
if settingsUI.reveal.isSkip() then bits += 2 ^ 13 end
if settingsUI.skillTreeIsOn() then bits += 2 ^ 14 end
if hideEggEnabled then bits += 2 ^ 15 end
if hideDamageEnabled then bits += 2 ^ 16 end
if settingsUI.shrineIsOn() then bits += 2 ^ 17 end
return "AG2-" .. base36(i) .. "-" .. base36(bits)
end
function settingsUI.decodeCompact(code)
local a, b = tostring(code):upper():match("^AG2%-([0-9A-Z]+)%-([0-9A-Z]+)$")
if not a then return nil end
local i, bits = tonumber(a, 36), tonumber(b, 36)
if not i or not bits or i < 1 or i > #raw or bits < 0 or bits > 262143 then
return nil
end
local function hasBit(n) return math.floor(bits / 2 ^ n) % 2 == 1 end
local main = {}
for index, key in ipairs(keyOrder) do main[key] = hasBit(index - 1) end
return {
Main = main,
Egg = raw[i][1],
AutoEgg = hasBit(8), AutoEvent = hasBit(9),
AutoHoldReveal = hasBit(12), SkipSecretCutscene = hasBit(13),
AutoSkillTree = hasBit(14), HideEggAnimation = hasBit(15),
HideDamage = hasBit(16), AutoShrine = hasBit(17),
InfiniteJump = hasBit(6), Optimizer = hasBit(7)
}
end
end
