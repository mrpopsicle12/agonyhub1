        -- An OFF action takes priority over the start cooldown; the game's
        -- synchronous ToggleAutoHatch() safely clears its active state.
        local c = getNativeController()
        if not c then
            -- If Delta prevents requiring the module, the exact native Stop
            -- button is still a safer fallback than another F toggle.
            local pressed = activateExactStopButton()
            return pressed and nativeEgg() == nil
        end
        local reported, valid = controllerEgg()
        lastNativeAction = os.clock()
        local success
        if valid and reported == current then
            -- Calling ToggleAutoHatch once with any egg stops the active
            -- session; its internal v_u_93 is set to nil synchronously.
            success = pcall(c.ToggleAutoHatch, c, current)
        elseif valid and reported == nil then
            -- NEVER call ToggleAutoHatch here: it would START a second loop.
            success = activateExactStopButton()
        else
            success = false
        end
        if success and nativeEgg() == nil then
            settingsUI.nativePending = false
            return true
        end
        return false
    end

    function settingsUI.nativeAutoStart(egg)
        if type(egg) ~= "string" or egg == "" then return false end
        if settingsUI.nativeStopQueued then return false end
        local activeEgg = nativeEgg()
        if activeEgg then return activeEgg == egg end
        local c = getNativeController()
        if not c then return false end
        -- Prevent accidental double toggles from a short burst of callbacks.
        if os.clock() - lastNativeAction < 0.85 then return false end
        lastNativeAction = os.clock()
        local ok = pcall(c.ToggleAutoHatch, c, egg)
        if ok then
            settingsUI.nativePending = true
            settingsUI.nativePendingAt = os.clock()
        end
        return ok
    end
end

local function stopHatch()
    -- Invalidate the worker BEFORE telling the game to stop.
    eggMode = nil
    eggToken += 1
    eggStatus.Text = "OFF"
    settingsUI.nativeStopQueued = true
    local stopOk, stopped = pcall(settingsUI.nativeAutoStop)
    if stopOk and stopped then
        settingsUI.nativeStopQueued = false
    else
        -- Native controller may still be inside a transition; verify once,
        -- then leave it OFF. Do not press F, which might restart Auto Open.
        task.spawn(function()
            for _ = 1, 3 do
                if not alive then break end
                if not settingsUI.nativeAutoActive() then break end
                task.wait(0.9)
                if not alive or eggMode ~= nil then break end
                pcall(settingsUI.nativeAutoStop)
            end
            settingsUI.nativePending = false
            settingsUI.nativeStopQueued = false
        end)
    end
end

local setEgg
local setEvent
local function startHatch(mode)
    if eggMode == mode then return end
    eggMode = mode
    eggToken += 1
    local generation = eggToken
    -- Restore persistent return-to-egg behavior, while continuing to use
    -- exactly one native EggController Auto-F start per recovery cycle.
    task.spawn(function()
        local function active()
            return alive and eggMode == mode and eggToken == generation
        end
        local lastEgg = nil
        local hasRequestedStart = false
        local hasStarted = false
        local wasPaused = false
        local lastStopAt = -math.huge
        local lastReturnAt = -math.huge
        local recoveryUntil = 0
        while active() do
            local target = mode == "Event" and "Glitched Egg" or eggSelected
            if target ~= lastEgg then
                lastEgg = target
                hasRequestedStart = false
                hasStarted = false
                recoveryUntil = os.clock() + 3
            end
            local paused = busyMovement or hatchTradePaused()
                or (flags.boss and bossPresent)
            local native = settingsUI.nativeAutoEgg()
            if paused then
                if native and os.clock() - lastStopAt >= 1 then
                    lastStopAt = os.clock()
                    pcall(settingsUI.nativeAutoStop)
                end
                wasPaused = true
                eggStatus.Text = "PAUSED"
            else
                if wasPaused then
                    wasPaused = false
                    hasRequestedStart = false
                    hasStarted = false
                    recoveryUntil = os.clock() + 4
                end
                if native and native ~= target then
                    if os.clock() - lastStopAt >= 1 then
                        lastStopAt = os.clock()
                        pcall(settingsUI.nativeAutoStop)
                    end
                    eggStatus.Text = "Switching egg"
                else
                    local root = currentRoot()
                    local hum = currentHum()
                    local stand = eggStand(target)
                    if not root or not hum or hum.Health <= 0 or not stand then
                        eggStatus.Text = "Waiting for egg/character"
                    else
                        local distance = (root.Position - stand.Position).Magnitude
                        if distance > 18 then
                            -- If trade, boss or world movement takes us away,
                            -- return automatically. The cooldown prevents the
                            -- old every-frame teleport / frozen avatar issue.
                            if os.clock() - lastReturnAt >= 2.5 then
                                lastReturnAt = os.clock()
                                local ok = pcall(function()
                                    root.AssemblyLinearVelocity = Vector3.zero
                                    root.AssemblyAngularVelocity = Vector3.zero
                                    root.CFrame = stand
                                end)
                                if ok then
                                    -- If the game invalidated Auto-F on
                                    -- leaving its range, permit ONE restart.
                                    hasRequestedStart = false
                                    hasStarted = false
                                    recoveryUntil = os.clock() + 4
                                end
                            end
                            eggStatus.Text = "Returning to egg"
                        elseif native == target then
                            hasRequestedStart = true
                            hasStarted = true
                            settingsUI.nativePending = false
                            eggStatus.Text = "Auto F running"
                        elseif settingsUI.nativeStopQueued then
                            eggStatus.Text = "Finishing previous stop"
                        elseif hasStarted then
                            -- Retry only after a real relocation/interruption;
                            -- avoid turning Auto F on again when the server
                            -- stopped it because of coins or game limits.
                            if os.clock() < recoveryUntil then
                                hasRequestedStart = false
                                hasStarted = false
                            else
                                eggStatus.Text = "Auto F stopped by game"
                            end
                        elseif not hasRequestedStart then
                            local ok = settingsUI.nativeAutoStart(target)
                            if ok then
                                hasRequestedStart = true
                                eggStatus.Text = "Starting Auto F"
                            else
                                eggStatus.Text = "Waiting for native Auto F"
                            end
                        elseif os.clock() - (settingsUI.nativePendingAt or 0) > 3 then
                            eggStatus.Text = "Auto F could not start"
                            hasStarted = true
                            settingsUI.nativePending = false
                        end
                    end
                end
            end
            task.wait(0.45)
        end
    end)
end
