        if entry.Claimed == true or entry.IsClaimed == true
            or entry.RewardClaimed == true or entry.Collected == true then return false end
        for _, key in ipairs({"CanClaim", "Claimable", "ReadyToClaim", "Ready", "Completed"}) do
            if entry[key] == true then return true end
        end
        local state = tostring(entry.State or entry.Status or ""):lower()
        if state == "claimable" or state == "ready" or state == "completed" then return true end
        local progress = tonumber(entry.Progress or entry.Count or entry.Current)
        local target = tonumber(entry.Required or entry.Goal or entry.Target)
        return progress ~= nil and target ~= nil and target > 0 and progress >= target
