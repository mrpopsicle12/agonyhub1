-- =============================================================
-- SECRET EGG DISCORD WEBHOOK (V11.9.1, OWN PLAYER ONLY)
-- Only listens to the server's EggService.RE.SecretEggFlash.
-- Does NOT modify Egg automation, Boss logic or shared configs.
-- =============================================================
do
    local w = settingsUI.webhook
    local webhook = {
        enabled = false,
        listening = false,
        connection = nil,
        event = nil,
        seen = {},
        queue = {},
        sending = false,
        url = ""
    }
    local path = folder .. "/_secret_webhook.json"

    local function cleanUrl(value)
        return (tostring(value or ""):match("^%s*(.-)%s*$") or "")
    end

    local function validDiscordWebhook(value)
        local url = cleanUrl(value)
        -- Restrict POST destinations to official Discord webhook endpoints.
        return url:match("^https://discord%.com/api/webhooks/%d+/[%w_%-%.]+%??[%w_%%=&%-]*$") ~= nil
            or url:match("^https://discordapp%.com/api/webhooks/%d+/[%w_%-%.]+%??[%w_%%=&%-]*$") ~= nil
    end

    local function setStatus(value, color)
        if not alive then return end
        local ok, err = pcall(function()
            if w.status.Parent then
                w.status.Text = tostring(value)
                w.status.TextColor3 = color or C.muted
            end
        end)
        if not ok then
            warn("[AGONY WEBHOOK] Status UI unavailable:", tostring(err):sub(1, 120))
        end
    end

    local function requestFunction()
        -- Use the shared executor HTTP helper for Discord webhook delivery.
        local ok, sharedRequest = pcall(findExecutorHttpRequest)
        if ok and type(sharedRequest) == "function" then return sharedRequest end
        for _, source in ipairs({env, _G}) do
            if type(source) == "table" then
                for _, key in ipairs({"request", "http_request", "httprequest"}) do
                    if type(source[key]) == "function" then return source[key] end
                end
                for _, key in ipairs({"syn", "http", "fluxus", "httpservice"}) do
                    local group = source[key]
                    if type(group) == "table" and type(group.request) == "function" then
                        return group.request
                    end
                end
            end
        end
        return nil
    end

    local function postDiscord(message)
        local url = cleanUrl(w.box.Text)
        -- Don't silently send to an older saved URL if the box was edited.
        if not validDiscordWebhook(url) then return false, "INVALID URL", 0 end
        local send = requestFunction()
        if not send then return false, "NO HTTP API", 0 end
        local okBody, body = pcall(function() return Http:JSONEncode(message) end)
        if not okBody then return false, "JSON ERROR", 0 end
        local ok, result = pcall(send, {
            Url = url,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = body
        })
        if not ok then
            warn("[AGONY WEBHOOK] HTTP request error:", tostring(result):sub(1, 180))
            return false, "REQUEST ERROR", 0
        end
        if type(result) ~= "table" then return false, "NO HTTP RESPONSE", 0 end
        local code = tonumber(result.StatusCode or result.status_code or result.Status)
        if (code and code >= 200 and code < 300)
            or (code == nil and result.Success == true) then
            return true, "SENT", 0
        end
        local retryDelay = 0
        if code == 429 then
            local headers = result.Headers or result.headers or {}
            if type(headers) == "table" then
                retryDelay = tonumber(headers["Retry-After"] or headers["retry-after"]) or 0
            end
            local responseBody = result.Body or result.body
            if retryDelay <= 0 and type(responseBody) == "string" then
                local decodedOk, decoded = pcall(function() return Http:JSONDecode(responseBody) end)
                if decodedOk and type(decoded) == "table" then
                    retryDelay = tonumber(decoded.retry_after) or 0
                end
            end
            return false, "RATE LIMITED", math.clamp(retryDelay > 0 and retryDelay or 3, 1, 15)
        end
        local reason = "HTTP " .. tostring(code or "ERROR")
        local responseBody = result.Body or result.body
        if type(responseBody) == "string" and responseBody ~= "" then
            local snippet = responseBody:gsub("[\r\n]", " "):sub(1, 130)
            warn("[AGONY WEBHOOK] Discord response:", reason, snippet)
        else
            warn("[AGONY WEBHOOK] Discord response:", reason)
        end
        return false, reason, 0
    end

    local function sendQueue()
        if webhook.sending then return end
        webhook.sending = true
        task.spawn(function()
            local ok, err = pcall(function()
                while alive and #webhook.queue > 0 do
                    if not webhook.enabled then
                        table.clear(webhook.queue)
                        break
                    end
                    local item = table.remove(webhook.queue, 1)
                    local msg = item.message
                    local success, reason, pause = postDiscord(msg)
                    local attempts = 1
                    while not success and attempts < 3 and alive and webhook.enabled
                        and (reason == "RATE LIMITED" or reason == "HTTP 500"
                            or reason == "HTTP 502" or reason == "HTTP 503"
                            or reason == "HTTP 504" or reason == "REQUEST ERROR") do
                        attempts += 1
                        task.wait(reason == "RATE LIMITED" and pause or 2)
                        if alive and webhook.enabled then
                            success, reason, pause = postDiscord(msg)
                        end
                    end
                    if webhook.enabled then
                        setStatus(reason, success and C.green or C.red)
                    end
                    if not success and item.id then
                        -- An unsuccessful send must not suppress the hatch
                        -- for 180s if the remote repeats the same event.
                        webhook.seen[item.id] = nil
                    end
                    if #webhook.queue > 0 then task.wait(1) end
                end
            end)
            webhook.sending = false
            if not ok then
                warn("[AGONY WEBHOOK] Queue error:", tostring(err))
                if alive then setStatus("SEND ERROR", C.red) end
            end
        end)
    end

    local function pushMessage(message, eventId)
        if not alive or not webhook.enabled then return end
        if #webhook.queue >= 25 then table.remove(webhook.queue, 1) end
        table.insert(webhook.queue, {message = message, id = eventId})
        sendQueue()
    end

    -- SECRET EGG ENRICHMENT (LOCAL PLAYER ONLY)
    -- SecretEggFlash has Egg, Rarity, UserId and a pet *instance* GUID.
    -- Pet species, odds, mutation and lifetime hatches may not be sent by the event.
    -- Only use confirmed event, own replica and specific pet config fields.
    local function display(value, fallback)
        if value == nil or value == "" then return fallback or "Not reported" end
        if type(value) == "table" then
            local parts = {}
            for _, v in pairs(value) do
                if type(v) == "string" or type(v) == "number" then
                    parts[#parts + 1] = tostring(v)
                end
                if #parts >= 4 then break end
            end
            return #parts > 0 and table.concat(parts, ", ") or (fallback or "Not reported")
        end
        return tostring(value):sub(1, 500)
    end

    local function lookupField(t, keys)
        if type(t) ~= "table" then return nil end
        for _, key in ipairs(keys) do
            local v = t[key]
            if v ~= nil and v ~= "" then return v end
        end
        return nil
    end

    local function commaNumber(value)
        local num = tonumber(value)
        if not num or num == math.huge or num == -math.huge then
            return tostring(value)
        end
        local numberText = string.format("%.0f", num)
        local sign, digits = numberText:match("^(%-?)(%d+)$")
        if not digits then return numberText end
        local groups = {}
        while #digits > 3 do
            table.insert(groups, 1, digits:sub(-3))
            digits = digits:sub(1, -4)
        end
        table.insert(groups, 1, digits)
        return sign .. table.concat(groups, ",")
    end

    local function ownData()
        local ok, replica = pcall(function()
            return require(RS.Controllers.Core.DataController):GetReplica()
        end)
        if ok and type(replica) == "table" and type(replica.Data) == "table" then
            return replica.Data
        end
        return nil
    end

    local function petRecord(data)
        local fromEvent = lookupField(data, {"PetData", "PetInfo", "PetRecord"})
        if type(fromEvent) == "table" then return fromEvent end
        if tonumber(data.UserId) ~= player.UserId then return nil end
        local id = tostring(data.PetId or "")
        if id == "" then return nil end
        local root = ownData()
        if not root then return nil end
        local visited = {}
        local total = 0
        local function scan(node, depth)
            if type(node) ~= "table" or visited[node] or depth > 9
                or total >= 40000 then return nil end
            total += 1
            visited[node] = true
            if tostring(node.PetId or node.Id or node.ID
                or node.UUID or node.Guid or node.UniqueId or "") == id then
                return node
            end
            if type(node[id]) == "table" then return node[id] end
            for key, value in pairs(node) do
                if tostring(key) == id and type(value) == "table" then return value end
                if type(value) == "table" then
                    local found = scan(value, depth + 1)
                    if found then return found end
                end
            end
            return nil
        end
        return scan(root.Pets or root.Inventory or root, 0)
            or scan(root, 0)
    end

    local function petDetails(data, record)
        -- Do not treat category names such as "Prestige" or "Normal" as species.
        local function species(value)
            if type(value) == "table" then
                value = lookupField(value, {"PetName", "SpeciesName", "DisplayName", "Name", "Species"})
            end
            if type(value) ~= "string" then return nil end
            value = value:match("^%s*(.-)%s*$") or ""
            local low = value:lower()
            if value == "" or #value > 100
                or low == "normal" or low == "shiny" or low == "golden"
                or low == "rainbow" or low == "secret"
                or low == "exclusive" or low == "limited"
                or low == "basic" or low == "special" then return nil end
            return value
        end
        local pet = species(lookupField(data, {
            "PetName", "SpeciesName", "PetSpecies", "DisplayName", "Pet", "Name"
        }))
        if not pet and record then
            pet = species(lookupField(record, {
                "PetName", "SpeciesName", "PetSpecies", "DisplayName", "Species", "Name", "Pet", "PetType", "Type"
            }))
            if not pet and type(record.Pet) == "table" then
                pet = species(record.Pet)
            end
        end
        local odds = lookupField(data, {"Odds", "OneIn", "OneInChance", "Denominator"})
            or lookupField(record, {"Odds", "OneIn", "OneInChance", "Denominator"})
        if type(odds) == "number" then
            if odds > 0 then
                odds = odds >= 1 and ("1 in " .. commaNumber(odds)) or nil
            else
                odds = nil
            end
        end
        -- Only derive from fractional probability when explicitly labeled Probability.
        if not odds then
            local probability = tonumber(lookupField(data, {"Probability"})
                or lookupField(record, {"Probability"}))
            if probability and probability > 0 and probability < 1 then
                odds = "1 in " .. commaNumber(1 / probability)
            end
        end
        local mutation = lookupField(data, {
            "Mutation", "MutationName", "PetMutation", "Mutations", "Variant"
        }) or lookupField(record, {
            "Mutation", "MutationName", "PetMutation", "Mutations", "Variant"
        })
        -- In TS2, PetTier can signal a known visual variant such as Shiny.
        -- Only use recognized labels, never mistake numeric Tier for mutation.
        if not mutation then
            local variant = lookupField(data, {"PetTier"}) or lookupField(record, {"PetTier"})
            if type(variant) == "string" then
                local known = {normal = true, shiny = true, golden = true,
                    rainbow = true, glitched = true}
                if known[variant:lower()] then mutation = variant end
            end
        end
        return pet, odds, mutation
    end

    -- V11.9.1: PetOdds.Variant(baseOdds, tier, mutation, petName)
    -- Exact function signature confirmed in SecretCutsceneController.
    -- A Shiny's odds are different from the base species OneIn value.
    local function petOddsFromModule(petName, record, data, mutation)
        local petsFolder = RS:FindFirstChild("Shared")
        petsFolder = petsFolder and petsFolder:FindFirstChild("Pets")
        local module = petsFolder and petsFolder:FindFirstChild("PetOdds")
        if not module or not module:IsA("ModuleScript") then return nil end
        local ok, api = pcall(require, module)
        if not ok or type(api) ~= "table" or type(api.OneIn) ~= "function" then
            return nil
        end

        local names, used = {}, {}
        local function addName(value)
            if type(value) ~= "string" then return end
            value = value:match("^%s*(.-)%s*$")
            if not value or value == "" or used[value] then return end
            used[value] = true
            names[#names + 1] = value
        end
        addName(petName)
        addName(lookupField(record, {"Name", "PetName", "SpeciesName", "Species"}))
        addName(lookupField(data, {"PetName", "SpeciesName", "Name"}))

        local tier = lookupField(record, {"Tier", "PetTier"})
            or lookupField(data, {"PetTier"})
        if type(tier) ~= "string" or tier == "" then tier = nil end
        if type(mutation) ~= "string" or mutation == "" then
            mutation = nil
        end
        -- If PetTier itself names the mutation, don't apply it twice.
        if tier and mutation and tier:lower() == mutation:lower() then
            tier = nil
        end
        for _, name in ipairs(names) do
            local callOk, base = pcall(api.OneIn, name)
            if callOk then
                if type(base) == "table" then
                    base = lookupField(base, {"OneIn", "Odds", "Denominator"})
                end
                if type(base) == "string" then
                    base = tonumber((base:gsub(",", "")))
                end
                if type(base) == "number" and base >= 1 and base < math.huge then
                    local actual = base
                    local needsVariant = (mutation and mutation:lower() ~= "normal")
                        or (tier and tier:lower() ~= "normal")
                    local variantConfirmed = false
                    if type(api.Variant) == "function" and (tier or mutation) then
                        local variantOk, variant = pcall(
                            api.Variant, math.floor(base), tier, mutation, name
                        )
                        if variantOk and type(variant) == "number"
                            and variant >= 1 and variant < math.huge then
                            actual = variant
                            variantConfirmed = true
                        end
                    end
                    if needsVariant and not variantConfirmed then
                        -- Never label an unadjusted base OneIn as Shiny odds.
                        return "Variant odds unavailable"
                    end
                    return "1 in " .. commaNumber(actual)
                end
            end
        end
        return nil
    end

    local function configOdds(eggName, petName)
        -- Never infer odds from rarity alone: several species can have same rarity.
        if type(petName) ~= "string" or petName == "" then return nil end
        local ok, cfg = pcall(function()
            return require(RS.Shared.Pets.LaunchEggConfig)
        end)
        if not ok or type(cfg) ~= "table" then return nil end
        local root = (type(cfg.Eggs) == "table" and cfg.Eggs[eggName])
            or cfg[eggName]
        if type(root) ~= "table" then return nil end
        local seen = {}
        local function visit(node, depth, keyName)
            if type(node) ~= "table" or seen[node] or depth > 6 then return nil end
            seen[node] = true
            local name = lookupField(node, {"PetName", "Species", "Pet", "Name", "DisplayName"})
            if type(name) == "table" then name = lookupField(name, {"Name", "PetName"}) end
            if (type(name) == "string" and name == petName) or keyName == petName then
                local value = lookupField(node, {"OneIn", "Odds", "Denominator", "OneInChance"})
                if type(value) == "number" and value > 0 then
                    if value >= 1 then return "1 in " .. commaNumber(value) end
                elseif type(value) == "string" and value ~= "" then
                    return value
                end
            end
            for key, child in pairs(node) do
                if type(child) == "table" then
                    local match = visit(child, depth + 1, tostring(key))
                    if match then return match end
                end
            end
            return nil
        end
        return visit(root, 0, nil)
    end

    local function totalHatches(data)
        local keys = {
            "TotalHatches", "TotalEggsHatched", "TotalEggHatches", "EggsHatched",
            "EggsOpened", "TotalEggsOpened", "PetHatches", "Hatches"
        }
        local v = lookupField(data, keys)
        if type(v) == "number" then return commaNumber(v) end
        if type(v) == "string" and v:match("^%d+$") then return commaNumber(v) end
        for _, key in ipairs(keys) do
            local a = player:GetAttribute(key)
            if type(a) == "number" then return commaNumber(a) end
            local board = player:FindFirstChild("leaderstats")
            local stat = board and board:FindFirstChild(key)
            if stat and (stat:IsA("IntValue") or stat:IsA("NumberValue")) then
                return commaNumber(stat.Value)
            end
        end
        local root = ownData()
        if root then
            for _, node in ipairs({root, root.Stats or {}, root.Statistics or {},
                root.PetStats or {}, root.EggStats or {}, root.Progress or {}}) do
                local n = lookupField(node, keys)
                if type(n) == "number" then return commaNumber(n) end
                if type(n) == "string" and n:match("^%d+$") then return commaNumber(n) end
            end
        end
        return nil
    end

    local avatarCache = {}
    local function getAvatar(userId)
        if not userId then return nil end
        if avatarCache[userId] then return avatarCache[userId] end
        local url = "https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds="
            .. tostring(userId) .. "&size=150x150&format=Png&isCircular=false"
        local req = requestFunction()
        if req then
            local ok, response = pcall(req, {
                Url = url, Method = "GET", Timeout = 8
            })
            if ok and type(response) == "table" then
                local body = response.Body or response.body
                local good, parsed = pcall(function() return Http:JSONDecode(body) end)
                if good and type(parsed) == "table" and type(parsed.data) == "table"
                    and type(parsed.data[1]) == "table" then
                    local image = parsed.data[1].imageUrl
                    if type(image) == "string" and image:match("^https://") then
                        avatarCache[userId] = image
                        return image
                    end
                end
            end
        end
        -- A direct endpoint is a fallback; Discord may not always render redirects.
        return "https://www.roblox.com/headshot-thumbnail/image?userId="
            .. tostring(userId) .. "&width=150&height=150&format=png"
    end

    local function resolveUsername(userId)
        if not userId then return "Unknown Player" end
        local target = Players:GetPlayerByUserId(userId)
        if target then return target.Name end
        local ok, name = pcall(function()
            return Players:GetNameFromUserIdAsync(userId)
        end)
        return (ok and type(name) == "string" and name ~= "")
            and name or ("User " .. tostring(userId))
    end

    local function secretEmbed(data, userId, username, avatar, petName, odds, mutation, hatches)
        local egg = display(data.Egg, "Unknown")
        local rarity = display(data.Rarity, "Secret")
        local now = os.time()
        local profile = "https://www.roblox.com/users/" .. tostring(userId) .. "/profile"
        local hatchCount = display(hatches, "Unknown")

        -- Discord mobile-friendly layout:
        -- Egg source -> username + avatar -> Pet/Odds -> Rarity/Mutation -> date.
        -- Total Hatches stays in the footer (it was already working).
        local emb = {
            author = {name = "HATCHED FROM " .. egg .. " EGG"},
            title = username .. " (" .. tostring(userId) .. ")",
            url = profile,
            description = "**SECRET PET HATCHED!**",
            color = 16753920,
            fields = {
                {name = "Pet Name", value = display(petName, "Not available"), inline = true},
                {name = "Odds", value = display(odds, "Not available"), inline = true},
                -- Force the next two fields onto their own row.
                {name = "\226\128\139", value = "\226\128\139", inline = false},
                {name = "Rarity", value = rarity, inline = true},
                {name = "Mutation", value = display(mutation, "Normal"), inline = true}
            },
            footer = {
                text = "Total Hatches: " .. hatchCount .. " | AGONY HUB | "
                    .. os.date("!%d %b %Y, %I:%M:%S %p PHT", now + 28800)
            },
            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ", now)
        }
        if avatar then emb.thumbnail = {url = avatar} end
        return {
            username = "AGONY HUB",
            allowed_mentions = {parse = {}},
            embeds = {emb}
        }
    end

    local function handleSecret(data)
        if not alive or not webhook.enabled or type(data) ~= "table" then return end

        -- STRICT PRIVACY/FILTER: ignore every global secret hatch except OUR user.
        -- SecretEggFlash is a global broadcast, not a personal hatch-only event.
        if tonumber(data.UserId) ~= player.UserId then return end

        local rarity = tostring(data.Rarity or "")
        if not rarity:lower():find("secret", 1, true) then return end
        local egg = tostring(data.Egg or "Unknown")
        local uniqueId = tostring(data.PetId or "")
        if uniqueId == "" then
            uniqueId = tostring(player.UserId) .. ":" .. egg .. ":"
                .. rarity .. ":" .. tostring(data.Seed or "")
        end
        local now = os.clock()
        if webhook.seen[uniqueId] and now - webhook.seen[uniqueId] < 180 then return end
        webhook.seen[uniqueId] = now
        local count = 0
        for key, last in pairs(webhook.seen) do
            count += 1
            if now - last > 180 then webhook.seen[key] = nil end
        end
        if count > 200 then
            table.clear(webhook.seen)
            webhook.seen[uniqueId] = now
        end

        pcall(setStatus, "MY SECRET", C.blue)
        task.spawn(function()
            -- Even if pet enrichment fails, deliver the confirmed own-player
            -- SecretEggFlash event rather than losing the entire notification.
            local builtOk, built = pcall(function()
            local record
            -- The pet can replicate slightly AFTER SecretEggFlash arrives.
            -- Wait up to ~3 seconds for matching instance GUID in own inventory.
            for _ = 1, 7 do
                if not alive or not webhook.enabled then return end
                record = petRecord(data)
                if record then break end
                task.wait(0.45)
            end
            local username = player.Name
            local avatar = getAvatar(player.UserId)
            local petName, odds, mutation = petDetails(data, record)
            -- Prefer server-provided OneIn when present (can already be variant
            -- adjusted). Otherwise calculate actual odds via OneIn + Variant.
            local explicitEventOdds = lookupField(data, {
                "Odds", "OneIn", "OneInChance", "Denominator"
            })
            if not explicitEventOdds then
                local calculated = petOddsFromModule(petName, record, data, mutation)
                if calculated then odds = calculated end
            end
            if not odds then odds = configOdds(egg, petName) end
            local hatches = totalHatches(data)
            return secretEmbed(data, player.UserId, username, avatar,
                petName, odds, mutation, hatches)
            end)
            if not alive or not webhook.enabled then return end
            if not builtOk then
                warn("[AGONY WEBHOOK] Pet details unavailable; sending basic notification:", built)
                local fallbackOk, fallback = pcall(secretEmbed, data,
                    player.UserId, player.Name, nil, nil, nil,
                    data.Mutation or data.PetTier, nil)
                if not fallbackOk then return end
                built = fallback
            end
            pushMessage(built, uniqueId)
        end)
    end

    local function persistWebhook()
        local url = cleanUrl(w.box.Text)
        if not validDiscordWebhook(url) or not hasFile or not ensureFolder() then
            return false
        end
        return pcall(function()
            writefile(path, Http:JSONEncode({
                URL = url,
                Enabled = webhook.enabled,
                SavedMode = "v2" -- explicit ON/OFF state, persisted on toggle
            }))
        end)
    end

    local setWebhook = toggle(w.row, function(enabled)
        if enabled then
            if not validDiscordWebhook(w.box.Text) then
                setStatus("INVALID URL", C.red)
                error("Enter a valid Discord webhook URL first")
            end
            if not requestFunction() then
                setStatus("NO HTTP API", C.red)
                error("Executor does not expose an HTTP request function")
            end
            webhook.enabled = true
            webhook.url = cleanUrl(w.box.Text)
            setStatus(webhook.listening and "LISTENING" or "CONNECTING", C.green)
            persistWebhook()
        else
            webhook.enabled = false
            table.clear(webhook.queue)
            setStatus("OFF", C.muted)
            persistWebhook()
        end
    end)

    settingsUI.getWebhookConfig = function()
        return {URL = cleanUrl(w.box.Text), Enabled = webhook.enabled}
    end
    settingsUI.applyWebhookConfig = function(data)
        if type(data) ~= "table" then return end
        local newUrl = cleanUrl(data.URL)
        if newUrl ~= "" and not validDiscordWebhook(newUrl) then
            setStatus("IMPORTED URL INVALID", C.red)
            return
        end
        if webhook.enabled then pcall(setWebhook, false) end
        w.box.Text = newUrl
        webhook.url = newUrl
        if data.Enabled == true and validDiscordWebhook(newUrl) then
            local ok, err = pcall(setWebhook, true)
            if not ok then warn("[AGONY WEBHOOK] Config enable failed:", err) end
        else
            persistWebhook()
            setStatus("OFF (CONFIG)", C.muted)
        end
    end

    on(w.box.FocusLost, function()
        webhook.url = cleanUrl(w.box.Text)
        if webhook.enabled and not validDiscordWebhook(webhook.url) then
