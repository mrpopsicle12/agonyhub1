end
local forward = Vector3.new(
cf.LookVector.X,
0,
cf.LookVector.Z
)
if forward.Magnitude < 0.1 then
forward = Vector3.new(0, 0, -1)
end
forward = forward.Unit
local right = Vector3.new(
-forward.Z,
0,
forward.X
)
local pos = cf.Position
+ forward * 6.5
- right * 2.5
+ Vector3.new(0, 2, 0)
return CFrame.lookAt(
pos,
Vector3.new(
cf.Position.X,
pos.Y,
cf.Position.Z
)
)
end
