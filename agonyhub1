    local function gatherQuestNames()
        local ids = {}
        local success, data, definitions, visibility = pcall(function()
            local repl = require(RS.Controllers.Core.DataController):GetReplica()
            if not repl then return nil end
            local cfg = require(RS.Shared.Quests.QuestConfig)
            local shown = require(RS.Shared.Quests.QuestVisibility)
            return repl.Data, cfg.Definitions, shown
        end)
        if success and type(data) == "table"
            and type(data.Quests) == "table"
            and type(definitions) == "table" then
            for id, record in pairs(data.Quests) do
