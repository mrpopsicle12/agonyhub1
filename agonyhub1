do
    local lastScanAt, cachedIndex = -math.huge, nil
    local function guiIsShown(obj)
        local cursor = obj
        while cursor and cursor ~= pg do
            if cursor:IsA("GuiObject") and not cursor.Visible then return false end
            if cursor:IsA("ScreenGui") and not cursor.Enabled then return false end
            cursor = cursor.Parent
        end
        return cursor == pg
    end
    local function rebirthIndex()
        local now = os.clock()
        if now - lastScanAt < 0.4 then return cachedIndex end
        lastScanAt = now
        cachedIndex = nil -- never reuse a previous world's numeric rebirth index
        local bestScore = -math.huge
        local function examine(options, inPrimaryHud)
            local highVisible, highAny = nil, nil
            for _, choice in ipairs(options:GetChildren()) do
                if choice:IsA("GuiObject") then
                    local number = tonumber(choice.Name)
                        or tonumber(choice:GetAttribute("Index"))
                        or tonumber(choice.Name:match("[Oo]ption[_ ]?(%d+)$"))
                    if number and number >= 1 and number % 1 == 0 then
                        if not highAny or number > highAny then highAny = number end
                        if guiIsShown(choice) and (not highVisible or number > highVisible) then
                            highVisible = number
                        end
                    end
                end
            end
            if not highAny then return end
            -- Never prefer old invisible World-1 rebirth controls over a
            -- newly replicated and visible World-2 rebirth menu.
            local score = (highVisible and 200 or 0)
                + (guiIsShown(options) and 100 or 0)
                + (inPrimaryHud and 15 or 0)
            if score > bestScore then
                bestScore = score
                cachedIndex = highVisible or highAny
            end
        end
        local hud = pg:FindFirstChild("RightHud")
        local primary = hud and hud:FindFirstChild("Main")
        primary = primary and primary:FindFirstChild("RightUI")
        primary = primary and primary:FindFirstChild("Rebirths")
        primary = primary and primary:FindFirstChild("List")
        primary = primary and primary:FindFirstChild("Options")
        if primary then examine(primary, true) end
        -- Avoid scanning thousands of GUI instances every tick while the
        -- standard W1/W2 HUD is visible. Only broaden the search if needed.
        local function isRebirthOptions(candidate)
            if candidate.Name ~= "Options" or candidate == primary then return false end
            local ancestor = candidate.Parent
            for _ = 1, 7 do
                if not ancestor or ancestor == pg then break end
                if tostring(ancestor.Name):lower():find("rebirth", 1, true) then
                    return true
                end
                ancestor = ancestor.Parent
            end
            return false
        end
        if bestScore < 300 and hud then
            for _, candidate in ipairs(hud:GetDescendants()) do
                if isRebirthOptions(candidate) then examine(candidate, false) end
            end
        end
        if bestScore < 300 then
            for _, candidate in ipairs(pg:GetDescendants()) do
                if isRebirthOptions(candidate)
                    and (not hud or not candidate:IsDescendantOf(hud)) then
                    examine(candidate, false)
                end
            end
        end
        return cachedIndex
    end
    worker("rebirth", mainRows.rebirth, 0.3, function(active)
        local remote = getRemote({"RemoteServices", "RebirthService", "RE", "RebirthRequested"})
        if not remote or not (remote:IsA("RemoteEvent") or remote:IsA("UnreliableRemoteEvent"))
            or not active() then return end
        local index = rebirthIndex()
        if index then
            remote:FireServer({Index = index})
        end
    end)
end
