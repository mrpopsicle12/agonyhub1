    end

    local function invokeClaim(serviceName, method, payload)
        local service = commService(serviceName)
        if service then
            local f = service[method]
            if type(f) == "function" then
                return pcall(function() return f(service, payload) end)
            end
        end
        local direct = getRemote({"RemoteServices", serviceName, "RF", method}, "RemoteFunction")
        if direct then return pcall(function() return direct:InvokeServer(payload) end) end
        return false, "METHOD UNAVAILABLE"
