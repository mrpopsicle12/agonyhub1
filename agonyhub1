    local function rebuildPetPicker()
        for _, child in ipairs(petList:GetChildren()) do
            if child:IsA("GuiButton") or child:IsA("TextLabel") then child:Destroy() end
        end
        local pets, data = ownedPets()
        if not pets then
            tradeStatus("Pet inventory not loaded; press REFRESH", C.red)
            return
        end
        local filter = tradeSearch.Text:lower()
        local available = {}
        for id, record in pairs(pets.Owned) do
            if availablePet(id, record, pets, data) then
                local name = record.Name
                local tier = tostring(record.Tier or "Normal")
                local mutation = tostring(record.Mutation or "")
                local description = name .. " " .. tier .. " " .. mutation
                if filter == "" or description:lower():find(filter, 1, true) then
                    table.insert(available, {
                        Id = id, Name = name, Tier = tier, Mutation = mutation
                    })
                end
            end
        end
        table.sort(available, function(a, b)
            local aa, bb = a.Name:lower(), b.Name:lower()
            return aa == bb and a.Id < b.Id or aa < bb
        end)
        local limit = math.min(80, #available)
        for i = 1, limit do
            local entry = available[i]
            local n = button(petList, "", UDim2.new(1, -7, 0, 29))
            n.LayoutOrder = i
            n.TextXAlignment = Enum.TextXAlignment.Left
            n.TextSize = 10
            local function redraw()
                local checked = selectedPets[entry.Id] == true
                local suffix = entry.Mutation ~= "" and entry.Mutation ~= "Normal"
                    and (" / " .. entry.Mutation) or ""
                n.Text = (checked and "  [x] " or "  [ ] ") .. entry.Name
                    .. " (" .. entry.Tier .. suffix .. ") #" .. entry.Id:sub(-6)
                n.BackgroundColor3 = checked and C.selected or C.side
            end
            redraw()
            n.MouseButton1Click:Connect(function()
                if autoEnabled then
                    tradeStatus("Turn OFF Auto Trade before editing pets", C.red)
                    return
                end
                if not selectedPets[entry.Id] and petCount() >= maxTradePets() then
                    tradeStatus("Trade pet limit: " .. maxTradePets(), C.red)
                    return
                end
                selectedPets[entry.Id] = not selectedPets[entry.Id] or nil
                redraw()
                updateCount()
            end)
        end
        if #available == 0 then
            local msg = label(petList, "No tradeable pets match your search", UDim2.new(1, -12, 0, 26), nil, 10)
            msg.TextColor3 = C.muted
        end
        if #available > 80 then
            tradeStatus("Showing 80 of " .. #available .. "; search to narrow")
        else
            tradeStatus("Select pets, then switch Auto Trade ON")
        end
        updateCount()
    end
