        window.Visible = true
        float.Visible = true
    end)
    if not opened then
        warn("[AGONY GUI] Failed to open GUI:", openError)
    end
    pcall(function() loading:Destroy() end)
end
task.spawn(function()
    while alive and not loadingFinished do
        local progress = math.clamp((os.clock() - started) / 10, 0, 1)
        local success, err = pcall(function()
            barFill.Size = UDim2.fromScale(progress, 1)
            barLabel.Text = "Loading... " .. math.floor(progress * 100) .. "%"
        end)
        if not success then
            warn("[AGONY GUI] Loader update failed:", err)
            break
        end
        if progress >= 1 then break end
        task.wait(0.05)
    end
    finishLoading()
end)
